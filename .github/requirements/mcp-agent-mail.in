# PyPI is still at 0.1.0; pin the v0.3.2 release commit until upstream
# publishes current wheel/sdist assets.
mcp-agent-mail @ https://github.com/Dicklesworthstone/mcp_agent_mail/archive/32783f6848bd63c425c4b5004cee3350016635fb.tar.gz

# Security floor: GitPython < 3.1.59 has multiple HIGH-severity command
# injection and path traversal advisories reported by the image gate, plus
# CVE-2026-78676 (CRITICAL, remote code execution); < 3.1.60 adds
# CVE-2026-87817 (HIGH, remote code execution) and CVE-2026-87819 (HIGH,
# regular-expression denial of service); <= 3.1.61 adds GHSA-59cr-6r3x-644w
# (MEDIUM, submodule update path traversal writes outside the repository).
# Pinning the floor ensures the resolver picks the patched version even if
# mcp-agent-mail's transitive constraint allows older. Drop this line once
# mcp-agent-mail upstream pins GitPython>=3.1.62 itself.
gitpython>=3.1.62

# Security floor: CVE-2026-69244 affects aiohttp < 3.14.3; GHSA-494j-54xm-rwp3,
# GHSA-5wr8-gcqf-gqf3, GHSA-2g87-pp6c-29x5, GHSA-9xw5-w5jj-pvcg,
# GHSA-pqxq-w44r-73xw, GHSA-6cjc-53gc-5rqm, GHSA-gx76-c99x-2c96 and
# GHSA-f9xw-jh8m-3mwq affect aiohttp < 3.14.4. Keep this explicit until
# mcp-agent-mail's transitive requirements carry the fixed release.
aiohttp>=3.14.4

# Security floor: CVE-2026-63374 (CRITICAL, TLSStream IDNA 2003 host name
# encoding enables host name confusion) in anyio < 4.14.2. anyio arrives
# transitively via httpx, mcp, openai, py-key-value-aio, sse-starlette,
# starlette and watchfiles; pin the floor until one of them carries the
# patched release itself.
anyio>=4.14.2

# Security floor: Pillow < 12.3.0 has multiple HIGH-severity image parsing
# vulnerabilities reported by the image gate; Pillow < 13.0.0 adds
# GHSA-8g5g-8vmr-9782 (CRITICAL), GHSA-c6hw-5grf-ff96, GHSA-462x-pgg6-55fp,
# GHSA-p4wg-p73j-c528, GHSA-pchr-8j38-3x4p, GHSA-q45j-58j2-45rg,
# GHSA-vx6w-vv9f-6gvg, GHSA-65qm-jvmh-6pqg and GHSA-58r4-6rv3-gfh8.
# mcp-agent-mail declares pillow>=10.4.0 and only uses Image.open/convert and
# WebP save, none of which changed in 13.0. Drop this line once transitive
# constraints carry the patched version themselves.
pillow>=13.0.0

# Security floor: urllib3 < 2.7.0 has GHSA-mf9v-mfxr-j63j (HIGH,
# decompression-bomb safeguards bypassed in parts of the streaming API)
# and GHSA-qccp-gfcp-xxvc (HIGH, sensitive headers forwarded across
# origins in proxied low-level redirects); urllib3 < 2.8.0 has
# CVE-2026-97687 (HIGH, traffic interception via HTTPS proxy TLS) and
# CVE-2026-97689 (HIGH, unbounded-memory denial of service). Pinning floor
# at 2.8.0 until transitive constraints pull a patched version on their own.
urllib3>=2.8.0

# Security floor: CVE-2026-104851 (HIGH, arbitrary code execution via a
# crafted fsspec URL) in fsspec < 2026.6.0. fsspec arrives transitively via
# huggingface-hub; drop once its constraint carries the patched release itself.
fsspec>=2026.6.0

# Security floor: idna < 3.15 has GHSA-65pc-fj4g-8rjx (MEDIUM, IDNA
# bypass of the CVE-2024-3651 fix). Drop once transitive constraints
# carry the patched version themselves.
idna>=3.15

# Security floor: CVE-2026-49468 (CRITICAL, authentication bypass via Host
# Header Injection) in litellm < 1.84.0. CVE-2026-84377 (MEDIUM) affects
# litellm < 1.88.6 and each line from 1.89 through 1.96 before its patch
# release (1.89.7, 1.90.7, 1.91.5, 1.92.2, 1.93.2, 1.94.3, 1.95.1, 1.96.2).
# A bare floor cannot express that, so any litellm move must land on a
# patched release. Drop once mcp-agent-mail's transitive constraint carries
# the patched version itself. Before dropping it, move this note next to the
# litellm lock-pin row in TestMCPMailImagePinsPatchedPythonDependencies
# (scripts/container_tool_security_test.go). That exact pin, not this
# floor, is what makes a re-lock onto an unpatched 1.90-1.96 release fail.
litellm>=1.89.7

# Security floor: CVE-2026-49852 (HIGH, HS256/HS384/HS512 verify accepts an
# empty/nil HMAC key — cross-language sibling of CVE-2026-45363) in joserfc
# < 1.6.8. joserfc arrives transitively via authlib; pin the floor until
# authlib's transitive constraint carries the patched version itself.
joserfc>=1.6.8

# Security floor: CVE-2026-52869 + CVE-2026-52870 (HIGH, fixed 1.27.2 — HTTP
# transports serve session requests without verifying the authenticated
# session, and experimental task handlers are reachable by any client) and
# CVE-2026-59950 (HIGH, fixed 1.28.1 — WebSocket transport lacks Host/Origin
# validation) in the mcp Python SDK < 1.28.1, and GHSA-84m7-p3x7-pcfv in
# mcp < 1.30.0. mcp arrives transitively via fastmcp-slim (mcp<2.0,>=1.24.0);
# floor at 1.30.0 to clear all four. Drop once fastmcp-slim's transitive
# constraint carries the patched version itself.
mcp>=1.30.0

# Authlib and FastMCP security floors live in
# .github/requirements/mcp-agent-mail.overrides.txt because mcp-agent-mail
# v0.3.2 still caps Authlib below the fixed release.
