 }
+
+// Added by gascity third_party/patches (Bazel nogo support).
+// defaultGcImporter returns importer.Default(), except under an export-data
+// GOROOT -- one with compiled packages in $GOROOT/pkg/$GOOS_$GOARCH but no
+// sources or go command, as rules_go's stdlib provides to nogo actions --
+// where it reads standard-library export data from that directory instead of
+// running `go list -export`, which cannot work there.
+func defaultGcImporter(fset *token.FileSet) types.Importer {
+	goroot := os.Getenv("GOROOT")
+	if goroot == "" {
+		return importer.Default()
+	}
+	goos, goarch := os.Getenv("GOOS"), os.Getenv("GOARCH")
+	if goos == "" {
+		goos = runtime.GOOS
+	}
+	if goarch == "" {
+		goarch = runtime.GOARCH
+	}
+	dir := filepath.Join(goroot, "pkg", goos+"_"+goarch)
+	if _, err := os.Stat(filepath.Join(dir, "runtime.a")); err != nil {
+		return importer.Default()
+	}
+	return importer.ForCompiler(fset, "gc", func(path string) (io.ReadCloser, error) {
+		return os.Open(filepath.Join(dir, filepath.FromSlash(path)+".a"))
+	})
+}
