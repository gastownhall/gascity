diff -ruN a/internal/storage/schema/BUILD.bazel b/internal/storage/schema/BUILD.bazel
--- a/internal/storage/schema/BUILD.bazel	2026-09-23 12:15:55.244530897 +0000
+++ b/internal/storage/schema/BUILD.bazel	2026-09-23 12:15:55.257530882 +0000
@@ -0,0 +1,15 @@
+
+# Patched for gascity bazel farm: expose the exact pinned sources read by the
+# cursor drift tests as public runfiles data. A pure-Bazel machine has no Go
+# module cache from which to resolve them.
+filegroup(
+    name = "migrations",
+    srcs = glob(["migrations/**"]),
+    visibility = ["//visibility:public"],
+)
+
+filegroup(
+    name = "pinned_cursor_sources",
+    srcs = ["schema.go"] + glob(["migrations/**"]),
+    visibility = ["//visibility:public"],
+)
