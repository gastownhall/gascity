+// ParseExcludeStatus reads a caller's status exclusion list — the listing's
+// ExcludeStatus — into the statuses it names. Entries may be comma-separated
+// and are trimmed; blanks are skipped. Each name IS validated against the
+// workspace vocabulary (built-in statuses plus customStatusNames): a
+// misspelled exclusion would silently exclude nothing and answer a WIDER set,
+// so a typo is ErrValidation instead.
+func ParseExcludeStatus(raw []string, customStatusNames []string) ([]types.Status, error) {
+	var out []types.Status
+	for _, entry := range raw {
+		for _, s := range strings.Split(entry, ",") {
+			s = strings.TrimSpace(s)
+			if s == "" {
+				continue
+			}
+			status := types.Status(s)
+			if !status.IsValidWithCustom(customStatusNames) {
+				return nil, fmt.Errorf("invalid exclude-status %q (valid: %s)%.0w",
+					s, ValidStatusList(customStatusNames), issueops.ErrValidation)
+			}
+			out = append(out, status)
+		}
+	}
+	return out, nil
+}
