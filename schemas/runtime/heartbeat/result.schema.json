{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "session",
    "held_until"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "ok": {
      "const": true
    },
    "command": {
      "const": "runtime heartbeat"
    },
    "session": {
      "type": "string"
    },
    "held_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
