{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "session",
    "draining"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "ok": {
      "const": true
    },
    "command": {
      "const": "runtime drain-check"
    },
    "session": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "draining": {
      "type": "boolean"
    },
    "source": {
      "enum": [
        "session_row",
        "runtime_meta",
        "session_row+runtime_meta"
      ]
    }
  },
  "additionalProperties": true
}
