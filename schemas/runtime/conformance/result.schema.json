{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "executable",
    "protocol",
    "v2_ready",
    "results",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "ok": {
      "const": true
    },
    "executable": {
      "type": "string"
    },
    "protocol": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locality": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "v2_ready": {
      "type": "boolean"
    },
    "v2_missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "v2_failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "group",
          "title",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "environment": {
      "type": "object",
      "required": [
        "executable",
        "declaredCapabilities",
        "results",
        "summary"
      ],
      "properties": {
        "executable": {
          "type": "string"
        },
        "declaredCapabilities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "title",
              "declared",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "declared": {
                "type": "boolean"
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "detail": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIP"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  }
}
