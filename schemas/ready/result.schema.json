{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc ready result",
  "description": "The payload of `gc ready`, in one of two shapes. The default (and --dispatchable) arm is a bare JSON array of ready (claimable) beads, in bd's `bd ready --json` row shape: `gc ready` is a drop-in for that single-store command across a split city's stores, so its payload is bd's row contract rather than the gc envelope, and consumers already decode this array directly (the hook work-query path unmarshals it into []beads.Bead). The --census arm is a single object carrying the dispatchable count and its class breakdown, because a count is not a row. Both are raw (non-envelope) payloads. Field names in the row shape match the HTTP Bead schema \u2014 `issue_type` for the type, `parent` for the parent \u2014 and NOT `gc bd dep tree --json`, which uses `parent_id`.",
  "x-gc-raw-json": true,
  "oneOf": [
    {
      "type": "array",
      "description": "The default and --dispatchable arm: the ready rows themselves.",
      "items": {
        "$ref": "#/$defs/readyRow"
      }
    },
    {
      "$ref": "#/$defs/census"
    }
  ],
  "$defs": {
    "readyRow": {
      "type": "object",
      "description": "One ready bead, in bd's `bd ready --json` row shape.",
      "required": [
        "id",
        "title",
        "status",
        "issue_type",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "issue_type": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "assignee": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issue_id",
              "depends_on_id",
              "type"
            ],
            "properties": {
              "issue_id": {
                "type": "string"
              },
              "depends_on_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "ephemeral": {
          "type": "boolean"
        },
        "no_history": {
          "type": "boolean"
        },
        "defer_until": {
          "type": "string",
          "format": "date-time"
        },
        "is_blocked": {
          "type": "boolean"
        },
        "close_reason": {
          "type": "string"
        },
        "blocked_by": {
          "type": "array",
          "description": "Blocking dependencies of this row, each carrying the blocker's status. Populated only on the --status in_progress (crash-recovery) arm; absent elsewhere, which consumers read as not-blocked.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "census": {
      "type": "object",
      "description": "The --census arm: the dispatchable count the queue-health floor is measured against, alongside the breakdown that complements it. Every class is present, zero included, so a consumer never has to tell 'absent' from 'zero'.",
      "required": [
        "dispatchable",
        "total",
        "in_flight",
        "by_class"
      ],
      "additionalProperties": false,
      "properties": {
        "dispatchable": {
          "type": "integer",
          "minimum": 0,
          "description": "Rows a worker could be handed now: not synthetic, not a step bead, not parked, not routed and not assigned."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Every row classified: dispatchable plus the exclusion classes."
        },
        "in_flight": {
          "type": "integer",
          "minimum": 0,
          "description": "Step beads of a live workflow, rows already routed to a seat, and open rows already assigned. Parked rows are deliberately NOT in flight."
        },
        "by_class": {
          "type": "object",
          "description": "Per-class counts, every class present even at zero.",
          "required": [
            "dispatchable",
            "synthetic",
            "step",
            "parked",
            "routed",
            "assigned"
          ],
          "additionalProperties": false,
          "properties": {
            "dispatchable": {
              "type": "integer",
              "minimum": 0
            },
            "synthetic": {
              "type": "integer",
              "minimum": 0
            },
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "parked": {
              "type": "integer",
              "minimum": 0
            },
            "routed": {
              "type": "integer",
              "minimum": 0
            },
            "assigned": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
