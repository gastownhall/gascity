            "required": [
              "template",
              "provider",
              "bucket_start"
            ],
            "properties": {
              "template": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "bucket_start": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "started": {
            "type": "integer"
          },
          "succeeded": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "other": {
            "type": "integer"
          },
          "min_duration_ms": {
            "type": "integer"
          },
          "max_duration_ms": {
            "type": "integer"
          },
          "avg_duration_ms": {
            "type": "number"
          },
