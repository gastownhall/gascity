{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "city_path", "waits"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "city_path": {
      "type": "string"
    },
    "waits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wait"
      }
    }
  },
  "$defs": {
    "wait": {
      "type": "object",
      "required": ["id", "session_id", "state", "kind", "status"],
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "session_name": { "type": "string" },
        "state": { "type": "string" },
        "kind": { "type": "string" },
        "dep_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dep_mode": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string" },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
