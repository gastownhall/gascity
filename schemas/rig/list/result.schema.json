{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc rig list --json result",
  "description": "One JSONL record listing the city and registered rigs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "city_path",
    "city_name",
    "rigs",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for this command output."
    },
    "ok": {
      "const": true
    },
    "city_path": {
      "type": "string",
      "description": "Absolute city root path."
    },
    "city_name": {
      "type": "string",
      "description": "Configured or inferred city name."
    },
    "_cache_age_s": {
      "type": "number",
      "description": "API-routed output only: the bead-cache age the server reported for this read (its X-GC-Cache-Age-S header). The server builds the rig list from config, the suspension state and runtime probes, not from its bead cache, so it reports 0."
    },
    "rigs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "prefix",
          "hq",
          "suspended",
          "running",
          "beads"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "default_branch": {
            "type": "string"
          },
          "hq": {
            "type": "boolean"
          },
          "suspended": {
            "type": "boolean"
          },
          "running": {
            "type": "boolean"
          },
          "default_sling_target": {
            "type": "string"
          },
          "default_sling_targets": {
            "type": "array",
            "description": "Configured default sling targets the rig picks among at random, when set.",
            "items": {
              "type": "string"
            }
          },
          "federation": {
            "type": "string",
            "enum": [
              "city",
              "rig"
            ],
            "description": "Rig federation setting; present only when not the default \"city\"."
          },
          "namespace": {
            "type": "string",
            "enum": [
              "shared",
              "exclusive"
            ],
            "description": "Rig namespace declaration; present only when not the default \"shared\"."
          },
          "beads": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "suspended",
        "running"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "suspended": {
          "type": "integer"
        },
        "running": {
          "type": "integer"
        }
      }
    }
  }
}
