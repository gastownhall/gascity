{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc worktree verify --json result",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "action",
    "path",
    "branch",
    "head",
    "created",
    "branch_created"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "ok": { "const": true },
    "command": { "const": "worktree verify" },
    "action": { "const": "verify" },
    "path": { "type": "string" },
    "branch": { "type": "string" },
    "head": { "type": "string" },
    "created": { "const": false },
    "branch_created": { "const": false },
    "planned": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "schema_version",
        "bead_id",
        "store_ref",
        "repo_identity",
        "path",
        "branch",
        "base_ref",
        "base_sha",
        "creator",
        "owner",
        "generation",
        "created_at",
        "lifecycle",
        "attempt_id"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "bead_id": { "type": "string" },
        "store_ref": { "type": "string" },
        "repo_identity": { "type": "string" },
        "path": { "type": "string" },
        "branch": { "type": "string" },
        "base_ref": { "type": "string" },
        "base_sha": { "type": "string" },
        "creator": { "type": "string" },
        "owner": { "type": "string" },
        "generation": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "lifecycle": { "type": "string" },
        "attempt_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
