{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc session list --json result",
  "description": "One JSON document listing durable Gas City sessions. Every route prints this shape; a read the city API served adds the optional _cache_age_s and the per-row running, reason, last_output and program_status fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "filters",
    "sessions",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1",
      "description": "Schema version for this command output."
    },
    "ok": {
      "const": true
    },
    "_cache_age_s": {
      "type": "number",
      "description": "API-routed output only: seconds since the server's bead cache last took in fresh data from its store (a full re-scan, or a write, event or row re-read it applied). It is the cache's age, not each row's, so it grows between re-scans and while the city is suspended. 0 when the server reads the store without a cache. Absent on a local read."
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "description": "State filter requested by the caller, when present."
        },
        "template": {
          "type": "string",
          "description": "Template filter requested by the caller, when present."
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "template",
          "state",
          "created_at",
          "last_active",
          "attached",
          "closed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "Lifecycle state; \"closed\" for a closed session."
          },
          "title": {
            "type": "string"
          },
          "rig": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "agent_name": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "description": "Local read only: the API redacts it."
          },
          "work_dir": {
            "type": "string"
          },
          "worker_dir": {
            "type": "string"
          },
          "session_name": {
            "type": "string"
          },
          "session_key": {
            "type": "string",
            "description": "Local read only: the API redacts it."
          },
          "resume_flag": {
            "type": "string",
            "description": "Local read only: the API redacts it."
          },
          "resume_style": {
            "type": "string",
            "description": "Local read only: the API redacts it."
          },
          "resume_command": {
            "type": "string",
            "description": "Local read only: the API redacts it."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339, UTC, second precision."
          },
          "last_active": {
            "oneOf": [
              {
                "const": ""
              },
              {
                "type": "string",
                "format": "date-time",
                "minLength": 1
              }
            ],
            "description": "RFC 3339, UTC, second precision; empty when the session has not been active."
          },
          "last_nudge_delivered_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339, UTC, second precision."
          },
          "attached": {
            "type": "boolean"
          },
          "closed": {
            "type": "boolean",
            "description": "True for a closed session, whose state is \"closed\"."
          },
          "running": {
            "type": "boolean",
            "description": "API-routed output only: whether the server observed the session runtime as live when it built the response (on tmux, a pane whose process has not exited). Absent on a local read; the CLI does not compute it."
          },
          "reason": {
            "type": "string",
            "description": "API-routed output only: the lifecycle reason the server reports."
          },
          "last_output": {
            "type": "string",
            "description": "API-routed output only."
          },
          "program_status": {
            "type": "object",
            "additionalProperties": false,
            "description": "The session program's own status report (OSC 7501), present while the city's program_status switch is shadow or on and the reading is valid. Absent means unknown, never idle.",
            "required": [
              "state",
              "since",
              "working_children"
            ],
            "properties": {
              "state": {
                "enum": [
                  "idle",
                  "working",
                  "done",
                  "blocked",
                  "error"
                ]
              },
              "kind": {
                "enum": [
                  "permission",
                  "question",
                  "auth"
                ]
              },
              "app": {
                "type": "string"
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "since": {
                "type": "string",
                "format": "date-time"
              },
              "quiet_since": {
                "type": "string",
                "format": "date-time"
              },
              "working_children": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "active",
        "suspended",
        "closed"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "active": {
          "type": "integer"
        },
        "suspended": {
          "type": "integer"
        },
        "closed": {
          "type": "integer"
        }
      }
    }
  }
}
