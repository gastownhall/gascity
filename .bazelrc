common --enable_bzlmod
common --color=no

# Side-by-side opt-in bazel arm. `go build`/`go test` continues to work unchanged.
# To use a remote cache, uncomment:
# build --remote_cache=<your-cache-endpoint>

test --test_output=errors
test --flaky_test_attempts=2


# Bazel sandboxes root t.TempDir() deep under the output tree, blowing past the
# 104-byte unix-socket sun_path limit for herdr/tmux/k8s socket tests. Root the
# per-test tmpdir short, like `go test` does with TMPDIR=/tmp. /tmp/bt is
# creatable by any user (CI runners, remote workers, dev machines alike).
test --test_tmpdir=/tmp/bt
test --sandbox_writable_path=/tmp/bt

# GOROOT is resolved hermetically from runfiles (@go_sdk//:srcs) by
# internal/bazeltest; no client export is required.
test --test_env=GC_TEST_REPO_ROOT


# Repo-lint tests exec `go` and other dev binaries; bazel's default test PATH
# is minimal, so forward the client's.
test --test_env=PATH

# Remote execution on the NativeLink farm. The executor endpoint is
# environment-specific and deliberately NOT hardcoded here (the public,
# credential-free fork cache below is the one exception): machines put it
# in the gitignored .bazelrc.local (e.g. a loopback grpc:// endpoint on the
# cache host, or your team's grpcs:// endpoint with mTLS), and CI passes it via
# the RBE step. Command-line flags always win.
try-import %workspace%/.bazelrc.local
build:remote-exec --remote_timeout=3600
# rbe-west accepts action-cache writes from its workers only: upload nothing
# executed locally (it would be refused, and host-dependent local results must
# not seed the shared cache anyway).
build:remote-exec --noremote_upload_local_results

# Read-only anonymous cache for fork PRs: rbe-west's rbe-cache endpoint serves
# action-cache and CAS reads only (writes and Execute are refused by the farm)
# and needs no credentials, so it is committed. bazel-test.yml selects it for
# runs without an executor (fork PRs, rbe=cache dispatches) by writing
# `build --config=fork-cache` to .bazelrc.local next to the trusted runs'
# key-affecting lines (scripts/bazel_fork_cache_test.go checks both). Only
# non-key flags differ from trusted runs, so fork actions hash like the
# trusted ones and hit what trusted CI executed.
build:fork-cache --remote_cache=grpcs://rbe-cache.ops.gascity.com:8443
build:fork-cache --remote_instance_name=oss
build:fork-cache --remote_accept_cached
build:fork-cache --noremote_upload_local_results
build:fork-cache --remote_download_minimal
# If the farm closes the endpoint (kill switch) GetCapabilities fails, and
# Bazel 9 then fails every action unless both of these are set.
build:fork-cache --remote_local_fallback
build:fork-cache --incompatible_remote_local_fallback_for_remote_cache
# Lookups are network-bound; local CPU work is still bounded by --local_resources.
build:fork-cache --jobs=64
# A slow (not closed) endpoint: each lookup gives up after 15s per attempt,
# and the failure-rate circuit breaker stops calling the endpoint once too
# many lookups fail (Bazel's default: 10% within 60s); the rest run locally.
build:fork-cache --remote_timeout=15
build:fork-cache --remote_retries=2
build:fork-cache --experimental_circuit_breaker_strategy=failure
# The farm admits 16 connections per source IP, and Blacksmith runners share
# egress IPs, so several concurrent fork jobs split that budget.
build:fork-cache --remote_max_connections=4

# --config=ci: what bazel.yml's lanes pass. The first three are the lines
# bazel-test.yml writes to .bazelrc.local, with byte-identical values so
# actions hash the same in both workflows and share the remote cache (the
# explicit test PATH is the key input; the bare --test_env=PATH above would
# forward the runner's). scripts/bazel_multilane_test.go keeps them equal.
test:ci --test_env=PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
build:ci --remote_download_minimal
# 2 vCPU runners default --jobs to 2, serializing even remote actions.
build:ci --jobs=64
# G0: a retried pass never stands in for a run (overrides the
# --flaky_test_attempts=2 above for CI lanes).
test:ci --flaky_test_attempts=1
# Lanes that are the only pre-merge run: every test executes, and a remote
# cache eviction fails the action rather than silently re-running it.
test:sole-run --nocache_test_results
test:sole-run --experimental_remote_cache_eviction_retries=0

# The tagged suites, as bazel-test.yml runs them (byte-identical values:
# --define and --test_timeout are key inputs). --test_timeout stays at or
# below 1100s: the scheduler caps action timeouts at 1200s.
test:acceptance --define=gotags=acceptance_a
test:acceptance --test_timeout=1100
test:integration --define=gotags=integration
test:integration --test_timeout=1100

# No --remote_cache_compression here: bazel-test.yml adds it for fork-cache
# while rbe-cache advertises zstd (tools/rbe/cache-zstd-probe.sh), so the
# server decides and rollback needs no change here.
