#!/usr/bin/env bash
# gc-session-screen — GNU screen session provider for Gas City.
#
# Implements the exec session provider protocol.
# See docs/exec-session-protocol.md for the full protocol specification.
#
# Dependencies: screen, jq, tar, sha256sum or shasum, bash
#
# Usage: GC_SESSION=exec:/path/to/gc-session-screen gc start <city>
#
# --- Gas Town feature parity notes ---
#
# The tmux provider (internal/session/tmux/) includes significant Gas Town
# theming and orchestration that this script does not yet implement:
#
# NOT IMPLEMENTED — Theming:
#   - Status bar colors (10-color palette with FNV-32a consistent hashing)
#   - Special role themes (Mayor=gold, Deacon=purple, Dog=brown)
#   - Role emoji in status bar (Mayor=hat, Crew=construction worker, etc.)
#   - Dynamic status-right with gt status-line output + clock
#   - Screen's hardstatus/caption could support a subset of this.
#
# NOT IMPLEMENTED — Keybindings:
#   - Mail click binding (left-click status bar → mail popup)
#   - Feed binding (Ctrl-b a → activity feed)
#   - Agent switcher (Ctrl-b g → agent menu popup)
#   - Session cycling (Ctrl-b n/p → cycle related sessions)
#   - Screen supports custom keybindings via 'bindkey'.
#
# NOT IMPLEMENTED — Session lifecycle:
#   - Remain-on-exit (pane stays visible after process exits for forensics)
#   - Auto-respawn hook (persistent agents restart after 3s debounce)
#   - Zombie detection (session exists but agent process dead)
#   - Screen supports 'zombie' mode and 'idle' commands for some of this.
#
# NOT IMPLEMENTED — Session naming:
#   - Name validation (alphanumeric + underscore/hyphen only)
#   - Exact-match session lookup (screen -list grep is fuzzy)
#
# SUPPORTED by screen but not wired up:
#   - Mouse mode (screen has limited mouse support)
#   - UTF-8 mode (screen -U flag)
#   - Activity timestamps (screen 'idle' command)

set -euo pipefail

op="${1:?missing operation}"
name="${2:-}"

# State directory for metadata sidecar files.
STATE_DIR="${GC_EXEC_STATE_DIR:-${TMPDIR:-/tmp}/gc-session-screen}"
mkdir -p "$STATE_DIR"

sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    return 127
  fi
}

# A script advertising the ownership capability must independently reject an
# incomplete or stale handoff. Go preflights the same contract, but validating
# again here prevents direct protocol callers and delayed starts from turning
# overlay suppression into a missing or unverified hook file.
validate_reconciler_owned_copy_files() {
  local config="$1"
  local work_dir="$2"
  local counts owned_count unique_count owned_path match_count entry
  local src probed expected_hash actual_hash expected_src parent

  if ! printf '%s' "$config" | jq -e '
    (.reconciler_owned_mergeable_paths // []) as $owned |
    (.copy_files // []) as $copies |
    ($owned | type == "array") and ($copies | type == "array") and
    all($owned[]; type == "string" and length > 0) and
    all($copies[]; type == "object")
  ' >/dev/null; then
    echo "start: invalid reconciler-owned staging payload" >&2
    return 1
  fi

  counts=$(printf '%s' "$config" | jq -r '
    (.reconciler_owned_mergeable_paths // []) as $owned |
    [($owned | length), ($owned | unique | length)] | @tsv
  ')
  owned_count=${counts%%$'\t'*}
  unique_count=${counts#*$'\t'}
  if [ "$owned_count" -ne "$unique_count" ]; then
    echo "start: duplicate reconciler-owned mergeable path" >&2
    return 1
  fi
  if [ "$owned_count" -gt 0 ] && [ -z "$work_dir" ]; then
    echo "start: reconciler-owned mergeable paths require work_dir" >&2
    return 1
  fi

  while IFS= read -r owned_path; do
    [ -z "$owned_path" ] && continue
    case "$owned_path" in
      .agents/hooks.json|.claude/settings.json|.gemini/settings.json|.codex/hooks.json|.cursor/hooks.json|.github/hooks/gascity.json)
        ;;
      *)
        echo "start: unsupported reconciler-owned mergeable path $owned_path" >&2
        return 1
        ;;
    esac

    match_count=$(printf '%s' "$config" | jq -r --arg rel "$owned_path" '
      [.copy_files[] | select(.rel_dst == $rel)] | length
    ')
    if [ "$match_count" -ne 1 ]; then
      echo "start: reconciler-owned path $owned_path requires exactly one copy_file (got $match_count)" >&2
      return 1
    fi
    entry=$(printf '%s' "$config" | jq -c --arg rel "$owned_path" '
      [.copy_files[] | select(.rel_dst == $rel)][0]
    ')
    src=$(printf '%s' "$entry" | jq -r '.src // ""')
    probed=$(printf '%s' "$entry" | jq -r '.probed == true')
    expected_hash=$(printf '%s' "$entry" | jq -r '.content_hash // ""')
    expected_src="${work_dir%/}/$owned_path"
    if [ -z "$src" ] || [ "$src" != "$expected_src" ]; then
      echo "start: reconciler-owned copy_file $owned_path must use canonical source $expected_src" >&2
      return 1
    fi
    if [ "$probed" != "true" ]; then
      echo "start: reconciler-owned copy_file $owned_path must be probed" >&2
      return 1
    fi
    if [ "${#expected_hash}" -ne 64 ] || [[ "$expected_hash" == *[!0-9a-f]* ]]; then
      echo "start: reconciler-owned copy_file $owned_path requires a SHA-256 content_hash" >&2
      return 1
    fi
    parent=$(dirname "$src")
    if [ ! -f "$src" ] || [ -L "$src" ] || [ ! -d "$parent" ] || [ -L "$parent" ]; then
      echo "start: missing or unsafe reconciler-owned copy_file $src" >&2
      return 1
    fi
    if ! actual_hash=$(sha256_stream < "$src"); then
      echo "start: failed to hash reconciler-owned copy_file $src" >&2
      return 1
    fi
    if [ "$actual_hash" != "$expected_hash" ]; then
      echo "start: reconciler-owned copy_file $owned_path changed after reconciliation" >&2
      return 1
    fi
  done < <(printf '%s' "$config" | jq -r '.reconciler_owned_mergeable_paths // [] | .[]')
}

case "$op" in
  protocol)
    printf '%s\n' '{"version":0,"capabilities":["staging.reconciler-owned-mergeable-paths"]}'
    ;;

  start)
    # Read JSON config from stdin.
    config=$(cat)
    work_dir=$(echo "$config" | jq -r '.work_dir // empty')
    command=$(echo "$config" | jq -r '.command // empty')
    env_json=$(echo "$config" | jq -r '.env // {} | to_entries[] | "\(.key)=\(.value)"' 2>/dev/null || true)

    if [ -z "$name" ]; then
      echo "start: missing session name" >&2
      exit 1
    fi
    validate_reconciler_owned_copy_files "$config" "$work_dir"

    # Check if session already exists.
    if screen -list 2>/dev/null | grep -q "[[:space:]]${name}[[:space:]]"; then
      echo "session \"$name\" already exists" >&2
      exit 1
    fi

    # Build a wrapper script that sets env vars, cd, and exec the command.
    wrapper="$STATE_DIR/${name}.wrapper.sh"
    {
      echo "#!/bin/sh"
      # Export environment variables.
      if [ -n "$env_json" ]; then
        while IFS= read -r line; do
          echo "export '$line'"
        done <<< "$env_json"
      fi
      # Change to working directory.
      if [ -n "$work_dir" ]; then
        echo "cd '$work_dir'"
      fi
      # Run the command or default shell.
      if [ -n "$command" ]; then
        echo "exec $command"
      else
        echo "exec \$SHELL"
      fi
    } > "$wrapper"
    chmod +x "$wrapper"

    # Copy overlay_dir contents into agent working directory.
    overlay_dir=$(echo "$config" | jq -r '.overlay_dir // ""')
    overlay_excludes=()
    while IFS= read -r owned_path; do
      case "$owned_path" in
        .agents/hooks.json|.claude/settings.json|.gemini/settings.json|.codex/hooks.json|.cursor/hooks.json|.github/hooks/gascity.json)
          overlay_excludes+=("--exclude=./$owned_path")
          ;;
      esac
    done < <(echo "$config" | jq -r '.reconciler_owned_mergeable_paths // [] | .[]' 2>/dev/null)
    if [ -n "$overlay_dir" ] && [ -d "$overlay_dir" ] && [ -n "$work_dir" ]; then
      if [ "${#overlay_excludes[@]}" -gt 0 ]; then
        # Preserve the reconciler's canonical hook/settings documents while
        # retaining legacy best-effort staging for every sibling overlay file.
        if ! (cd "$overlay_dir" && tar "${overlay_excludes[@]}" -cf - .) 2>/dev/null | \
          (cd "$work_dir" && tar -xf -) 2>/dev/null; then
          echo "start: failed to filter reconciler-owned overlay paths" >&2
          exit 1
        fi
      else
        cp -r "$overlay_dir/." "$work_dir/" 2>/dev/null || true
      fi
    fi

    # Overlay filtering can take long enough for a named-home file to change.
    # Recheck immediately before the self-copy handoff that makes suppression
    # authoritative.
    validate_reconciler_owned_copy_files "$config" "$work_dir"

    # Copy copy_files entries into agent working directory.
    while IFS= read -r entry; do
      [ -z "$entry" ] && continue
      src=$(echo "$entry" | jq -r '.src')
      rel_dst=$(echo "$entry" | jq -r '.rel_dst // ""')
      is_owned=$(echo "$config" | jq -r --arg rel "$rel_dst" 'any((.reconciler_owned_mergeable_paths // [])[]; . == $rel)')
      dst="${work_dir:-.}"
      [ -n "$rel_dst" ] && dst="$dst/$rel_dst"
      # Named local sessions source their canonical hook from the same workdir
      # destination. Verify that it still exists before treating it as staged;
      # the overlay fallback was deliberately suppressed for owned paths.
      if [ "$src" = "$dst" ]; then
        if [ ! -e "$src" ] && [ "$is_owned" = "true" ]; then
          echo "start: missing reconciler-owned copy_file $src" >&2
          exit 1
        fi
        continue
      fi
      if [ -d "$src" ]; then
        if ! mkdir -p "$dst" || ! cp -r "$src/." "$dst/" 2>/dev/null; then
          if [ "$is_owned" = "true" ]; then
            echo "start: failed to stage reconciler-owned copy_file $src" >&2
            exit 1
          fi
        fi
      elif [ -f "$src" ]; then
        if ! mkdir -p "$(dirname "$dst")" || ! cp "$src" "$dst" 2>/dev/null; then
          if [ "$is_owned" = "true" ]; then
            echo "start: failed to stage reconciler-owned copy_file $src" >&2
            exit 1
          fi
        fi
      elif [ "$is_owned" = "true" ]; then
        echo "start: missing reconciler-owned copy_file $src" >&2
        exit 1
      fi
    done < <(echo "$config" | jq -c '.copy_files // [] | .[]' 2>/dev/null)

    screen -dmS "$name" "$wrapper"
    ;;

  stop)
    if [ -z "$name" ]; then
      echo "stop: missing session name" >&2
      exit 1
    fi
    # Idempotent: no error if session doesn't exist.
    screen -S "$name" -X quit 2>/dev/null || true
    # Clean up wrapper and metadata.
    rm -f "$STATE_DIR/${name}.wrapper.sh"
    rm -f "$STATE_DIR/${name}".meta.*
    ;;

  interrupt)
    if [ -z "$name" ]; then exit 0; fi
    # Send Ctrl-C (0x03) to the session.
    screen -S "$name" -X stuff $'\x03' 2>/dev/null || true
    ;;

  is-running)
    if [ -z "$name" ]; then
      echo "false"
      exit 0
    fi
    if screen -list 2>/dev/null | grep -q "[[:space:]]${name}[[:space:]]"; then
      echo "true"
    else
      echo "false"
    fi
    ;;

  attach)
    if [ -z "$name" ]; then
      echo "attach: missing session name" >&2
      exit 1
    fi
    exec screen -r "$name"
    ;;

  process-alive)
    # Read process names from stdin (one per line).
    if [ -z "$name" ]; then
      echo "true"
      exit 0
    fi
    process_names=()
    while IFS= read -r pname; do
      [ -n "$pname" ] && process_names+=("$pname")
    done
    if [ ${#process_names[@]} -eq 0 ]; then
      echo "true"
      exit 0
    fi
    # Find the screen session's PID and check its process tree.
    screen_pid=$(screen -list 2>/dev/null | grep "[[:space:]]${name}[[:space:]]" | awk '{print $1}' | cut -d. -f1)
    if [ -z "$screen_pid" ]; then
      echo "false"
      exit 0
    fi
    # Walk the process tree looking for any matching process name.
    for pname in "${process_names[@]}"; do
      if pgrep -P "$screen_pid" -f "$pname" >/dev/null 2>&1; then
        echo "true"
        exit 0
      fi
    done
    echo "false"
    ;;

  nudge)
    if [ -z "$name" ]; then exit 0; fi
    msg=$(cat)
    # Type the message followed by Enter into the screen session.
    screen -S "$name" -X stuff "${msg}
" 2>/dev/null || true
    ;;

  set-meta)
    key="${3:?set-meta: missing key}"
    value=$(cat)
    echo -n "$value" > "$STATE_DIR/${name}.meta.${key}"
    ;;

  get-meta)
    key="${3:?get-meta: missing key}"
    meta_file="$STATE_DIR/${name}.meta.${key}"
    if [ -f "$meta_file" ]; then
      cat "$meta_file"
    fi
    # Empty stdout = not set (per protocol).
    ;;

  remove-meta)
    key="${3:?remove-meta: missing key}"
    rm -f "$STATE_DIR/${name}.meta.${key}"
    ;;

  peek)
    lines="${3:-0}"
    if [ -z "$name" ]; then
      exit 0
    fi
    # Use hardcopy to capture screen content.
    tmp=$(mktemp)
    screen -S "$name" -X hardcopy -h "$tmp" 2>/dev/null || { rm -f "$tmp"; exit 0; }
    if [ "$lines" -gt 0 ] 2>/dev/null; then
      tail -n "$lines" "$tmp"
    else
      cat "$tmp"
    fi
    rm -f "$tmp"
    ;;

  list-running)
    prefix="${name:-}"
    # Parse screen -list output, filter by prefix.
    screen -list 2>/dev/null | grep -oP '\d+\.\K[^\t]+' | while IFS= read -r sess; do
      if [ -z "$prefix" ] || [[ "$sess" == "$prefix"* ]]; then
        echo "$sess"
      fi
    done
    # Exit 0 even if no sessions found.
    exit 0
    ;;

  get-last-activity)
    # GNU screen does not expose activity timestamps.
    # Empty stdout = unsupported (per protocol).
    ;;

  copy-to)
    # Copy a file or directory into the session's working directory.
    # Screen runs locally, so this is a host-side copy.
    src="${3:-}"
    rel_dst="${4:-}"
    if [ -z "$name" ] || [ -z "$src" ]; then exit 0; fi
    # Read work_dir from the wrapper script (first cd line).
    wrapper="$STATE_DIR/${name}.wrapper.sh"
    work_dir=""
    if [ -f "$wrapper" ]; then
      work_dir=$(grep "^cd " "$wrapper" | head -1 | sed "s/^cd '//;s/'$//")
    fi
    [ -z "$work_dir" ] && exit 0
    dst="$work_dir"
    [ -n "$rel_dst" ] && dst="$work_dir/$rel_dst"
    if [ -d "$src" ]; then
      mkdir -p "$dst"
      cp -r "$src/." "$dst/" 2>/dev/null || true
    elif [ -f "$src" ]; then
      mkdir -p "$(dirname "$dst")"
      cp "$src" "$dst" 2>/dev/null || true
    fi
    ;;

  *)
    # Unknown operation — exit 2 for forward compatibility.
    exit 2
    ;;
esac
