load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "graphroute",
    srcs = ["graphroute.go"],
    importpath = "github.com/gastownhall/gascity/internal/graphroute",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/agentutil",
        "//internal/beadmeta",
        "//internal/beads",
        "//internal/config",
        "//internal/formula",
        "//internal/session",
        "//internal/storeref",
    ],
)

go_test(
    name = "graphroute_test",
    srcs = [
        "cook_rig_context_repro_test.go",
        "graphroute_test.go",
        "session_stamp_test.go",
        "testenv_import_test.go",
    ],
    embed = [":graphroute"],
    deps = [
        "//internal/agentutil",
        "//internal/beadmeta",
        "//internal/beads",
        "//internal/config",
        "//internal/formula",
        "//internal/session",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
