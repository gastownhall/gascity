load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "doltauth",
    srcs = ["auth.go"],
    importpath = "github.com/gastownhall/gascity/internal/doltauth",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/beads/contract"],
)

go_test(
    name = "doltauth_test",
    srcs = [
        "auth_test.go",
        "testenv_import_test.go",
    ],
    embed = [":doltauth"],
    deps = [
        "//internal/beads/contract",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
