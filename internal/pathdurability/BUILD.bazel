load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pathdurability",
    srcs = [
        "durability.go",
        "probe_linux.go",
        "probe_other.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/pathdurability",
    visibility = ["//:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "pathdurability_test",
    srcs = [
        "durability_test.go",
        "testenv_import_test.go",
    ],
    embed = [":pathdurability"],
    deps = ["//internal/testenv"],
)
