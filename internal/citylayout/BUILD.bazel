load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "citylayout",
    srcs = [
        "layout.go",
        "runtime.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/citylayout",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/pathutil"],
)

go_test(
    name = "citylayout_test",
    srcs = [
        "acp_transcripts_test.go",
        "runtime_test.go",
        "testenv_import_test.go",
    ],
    embed = [":citylayout"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
