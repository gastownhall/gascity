load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "suspensionstate",
    srcs = ["suspensionstate.go"],
    importpath = "github.com/gastownhall/gascity/internal/suspensionstate",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/citylayout",
        "//internal/fsys",
    ],
)

go_test(
    name = "suspensionstate_test",
    srcs = [
        "suspensionstate_test.go",
        "testenv_import_test.go",
    ],
    embed = [":suspensionstate"],
    deps = [
        "//internal/citylayout",
        "//internal/fsys",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
