    importpath = "github.com/gastownhall/gascity/internal/packman",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/builtinpacks",
        "//internal/config",
        "//internal/fsys",
        "//internal/git",
        "//internal/gitcred",
        "//internal/packregistry",
        "//internal/remotesource",
        "@com_github_burntsushi_toml//:toml",
    ] + select({
        "@rules_go//go/platform:aix": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:android": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:darwin": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:dragonfly": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:freebsd": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:illumos": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:ios": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:js": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:netbsd": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:openbsd": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:osx": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:plan9": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:qnx": [
            "//internal/processgroup",
        ],
        "@rules_go//go/platform:solaris": [
            "//internal/processgroup",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "packman_test",
    srcs = [
        "bundled_test.go",
        "cache_compat_test.go",
        "cache_test.go",
        "check_test.go",
        "install_test.go",
        "lockfile_test.go",
        "network_git_args_test.go",
        "network_git_group_unix_test.go",
        "network_git_test.go",
        "network_git_timeout_test.go",
        "prune_test.go",
        "registry_release_test.go",
        "resolve_test.go",
        "testenv_import_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":packman"],
    deps = [
        "//internal/builtinpacks",
        "//internal/config",
        "//internal/fsys",
        "//internal/gitcred",
        "//internal/packregistry",
        "//internal/processgroup/processgrouptest",
        "//internal/testenv",
        "//internal/testutil",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
