load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packman",
    srcs = [
        "cache.go",
        "check.go",
        "install.go",
        "lockfile.go",
        "networkgit_group_unix.go",
        "networkgit_group_windows.go",
        "prune.go",
        "registry_release.go",
        "resolve.go",
