load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "eventfact",
    srcs = [
        "checkpoint.go",
        "codec.go",
        "doc.go",
        "errors.go",
        "fact.go",
        "journal.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/eventfact",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beadmeta",
        "//internal/beads",
        "//internal/beads/ledgerfeed",
        "//internal/events",
        "//internal/opjournal",
        "@com_github_steveyegge_beads//journalops",
    ],
)

go_test(
    name = "eventfact_test",
    srcs = [
        "checkpoint_test.go",
        "codec_test.go",
        "journal_test.go",
        "testenv_import_test.go",
    ],
    embed = [":eventfact"],
    deps = [
        "//internal/beadmeta",
        "//internal/beads",
        "//internal/beads/ledgerfeed",
        "//internal/coordclass",
        "//internal/events",
        "//internal/opjournal",
        "//internal/testenv",
        "@com_github_steveyegge_beads//:beads",
        "@com_github_steveyegge_beads//journalops",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
