load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "localsocket",
    srcs = [
        "localsocket.go",
        "localsocket_unix.go",
        "localsocket_windows.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/platform/localsocket",
    visibility = ["//:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:windows": [
            "//internal/runtime",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "localsocket_test",
    srcs = [
        "localsocket_test.go",
        "testenv_import_test.go",
    ],
    embed = [":localsocket"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
