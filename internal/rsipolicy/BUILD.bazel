load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "rsipolicy",
    srcs = [
        "evidence.go",
        "policy.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/rsipolicy",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/reviewquorum"],
)

go_test(
    name = "rsipolicy_test",
    srcs = [
        "policy_test.go",
        "testenv_import_test.go",
    ],
    embed = [":rsipolicy"],
    deps = [
        "//internal/reviewquorum",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
