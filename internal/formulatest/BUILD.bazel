load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "formulatest",
    srcs = [
        "env.go",
        "v2.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/formulatest",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/formula"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
