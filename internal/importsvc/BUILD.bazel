load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "importsvc",
    srcs = [
        "importsvc.go",
        "manifest.go",
        "source.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/importsvc",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/fsys",
        "//internal/git",
        "//internal/gitcred",
        "//internal/packman",
        "//internal/pathutil",
        "//internal/pricing",
        "@com_github_burntsushi_toml//:toml",
    ],
)

go_test(
    name = "importsvc_test",
    srcs = [
        "importsvc_test.go",
        "source_test.go",
        "source_userinfo_test.go",
        "testenv_import_test.go",
    ],
    embed = [":importsvc"],
    deps = [
        "//internal/config",
        "//internal/fsys",
        "//internal/git",
        "//internal/packman",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
