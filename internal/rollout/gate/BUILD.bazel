load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "gate",
    srcs = ["gate.go"],
    importpath = "github.com/gastownhall/gascity/internal/rollout/gate",
    visibility = ["//:__subpackages__"],
)

exports_files(
    ["gate.go"],
    visibility = ["//visibility:public"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
