load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workladder",
    srcs = [
        "codec.go",
        "decide.go",
        "notice.go",
        "policy.go",
        "ratelimit.go",
        "types.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/workladder",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "workladder_test",
    size = "medium",
    srcs = [
        "codec_test.go",
        "decide_test.go",
        "notice_test.go",
        "progress_test.go",
        "property_test.go",
        "purity_test.go",
        "ratelimit_property_test.go",
        "ratelimit_test.go",
        "table_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    embed = [":workladder"],
    # The property sims in heavy_tests.txt are CPU-bound: each runs 10 to
    # 110 s on a typical worker, and a loaded worker stretches one up to about
    # 2.5x (the slowest seen, 269 s). rules_go gives test i of the declaration
    # order to shard i % shard_count. Six shards put two or three sims in one
    # shard, and two of those shards timed out at 300 s (ga-9yad1bw0). The
    # sims sit at positions 38, 43, 44, 45, 46, 48 and 49, all different mod 9,
    # so nine shards give each a shard of its own and the slowest sim is the
    # floor of the split. A test added or removed ahead of them shifts those
    # positions: scripts/workladder_shards_test.go fails when two share a shard
    # and prints the counts that keep them apart.
    shard_count = 9,
    deps = ["//internal/testenv"],
)

# The shard placement guard (scripts/workladder_shards_test.go) reads
# workladder_test's srcs and shard_count.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//scripts:__pkg__"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
