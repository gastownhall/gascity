load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workladder",
    srcs = [
        "codec.go",
        "decide.go",
        "notice.go",
        "policy.go",
        "ratelimit.go",
        "types.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/workladder",
    visibility = ["//:__subpackages__"],
)

_WORKLADDER_TEST_DATA = glob(
    ["**"],
    exclude = ["BUILD.bazel"],
)

go_test(
    name = "workladder_test",
    size = "medium",
    srcs = [
        "codec_test.go",
        "decide_test.go",
        "landing_budget_test.go",
        "notice_test.go",
        "progress_test.go",
        "property_test.go",
        "purity_test.go",
        "ratelimit_property_test.go",
        "ratelimit_test.go",
        "table_test.go",
        "testenv_import_test.go",
    ],
    args = [
        "-test.short",
    ],
    data = _WORKLADDER_TEST_DATA,
    embed = [":workladder"],
    # The landing suite uses the 10k property budget. Rate-limit sims also run
    # under -test.short (2k/500 random worlds plus fixed rare-branch seeds).
    # The 100k ladder proof does not run in CI. Run it explicitly with:
    # bazel test //internal/workladder:workladder_test \
    #   --test_arg=-test.short=false --test_timeout=900
    # The later --test_arg overrides this target's -test.short.
    shard_count = 6,
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
