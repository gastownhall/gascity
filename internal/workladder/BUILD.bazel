load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workladder",
    srcs = [
        "codec.go",
        "decide.go",
        "notice.go",
        "policy.go",
        "ratelimit.go",
        "types.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/workladder",
    visibility = ["//:__subpackages__"],
)

_WORKLADDER_TEST_DATA = glob(
    ["**"],
    exclude = ["BUILD.bazel"],
)

go_test(
    name = "workladder_test",
    size = "medium",
    srcs = [
        "codec_test.go",
        "decide_test.go",
        "landing_budget_test.go",
        "notice_test.go",
        "progress_test.go",
        "property_test.go",
        "purity_test.go",
        "ratelimit_property_test.go",
        "ratelimit_test.go",
        "table_test.go",
        "testenv_import_test.go",
    ],
    args = [
        "-test.short",
        "-test.skip=^TestRateLimitInvariants",
    ],
    data = _WORKLADDER_TEST_DATA,
    embed = [":workladder"],
    # The landing suite uses the 10k property budget. Keep the 100k and
    # rate-limit census proofs in the manual qualification target.
    shard_count = 6,
    deps = ["//internal/testenv"],
)

go_test(
    name = "workladder_qualification_test",
    size = "large",
    timeout = "long",
    srcs = [
        "codec_test.go",
        "decide_test.go",
        "notice_test.go",
        "progress_test.go",
        "property_test.go",
        "purity_test.go",
        "ratelimit_property_test.go",
        "ratelimit_test.go",
        "table_test.go",
        "testenv_import_test.go",
    ],
    data = _WORKLADDER_TEST_DATA,
    embed = [":workladder"],
    shard_count = 12,
    # Explicitly run the 100k property and rate-limit census proofs with:
    # bazel test //internal/workladder:workladder_qualification_test
    tags = ["manual"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
