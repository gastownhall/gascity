load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "testenv",
    srcs = ["testenv.go"],
    importpath = "github.com/gastownhall/gascity/internal/testenv",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "testenv_test",
    srcs = [
        "gc_env_baseline_test.go",
        "legacy_flag_freeze_test.go",
        "lint_test.go",
        "rollout_leak_vector_test.go",
        "testenv_internal_test.go",
        "testenv_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//:repo_source_tree",
    ],
    embed = [":testenv"],
    deps = [
        "//internal/bazeltest",
        "//internal/beads/contract",
        "//internal/rollout",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
