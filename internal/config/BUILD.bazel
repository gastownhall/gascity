load("@rules_go//go:def.bzl", "go_library", "go_test")

# Bounded Experiment 4b targets over real production source files. The complete
# config closure is still decomposing; `go test ./internal/config` remains
# authoritative for all config behavior.
go_library(
    name = "config_hermetic",
    srcs = [
        "diagnostic_locations.go",
        "envname.go",
        "identity_seam.go",
        "session_setup_path.go",
        "storage_endpoint.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/config",
    visibility = ["//visibility:public"],
)

go_test(
    name = "config_envname_test",
    srcs = ["config_envname_bazel_test.go"],
    embed = [":config_hermetic"],
    visibility = ["//visibility:public"],
)

# Second hermetic probe: diagnostic line parsing uses only the standard
# library and has no filesystem/process dependencies. It shares the bounded
# production library above, while the full config closure remains separate.
go_test(
    name = "config_diagnostic_locations_test",
    srcs = [
        "diagnostic_locations_fixture_bazel_test.go",
        "diagnostic_locations_test.go",
    ],
    embed = [":config_hermetic"],
    embedsrcs = ["testdata/diagnostic_locator.toml"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "config_storage_endpoint_test",
    srcs = ["storage_endpoint_bazel_test.go"],
    embed = [":config_hermetic"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "config_identity_seam_test",
    srcs = ["identity_seam_bazel_test.go"],
    embed = [":config_hermetic"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "config_session_setup_path_test",
    srcs = ["session_setup_path_test.go"],
    embed = [":config_hermetic"],
    visibility = ["//visibility:public"],
)
