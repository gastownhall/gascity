sh -c 'case "$GC_SESSION_ORIGIN" in ephemeral|"") ;; *) [ -n "$GC_ALIAS" ] && [ "$1" = "$GC_ALIAS" ] || exit 0 ;; esac; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; r=$(bd ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --limit=20) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd ready failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; gc_preferred_pool_demand=$(printf "%s" "$r" | jq -c '\''[.[] | select((((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "workflow" or ((.metadata["gc.workflow_expanded"] // "") | gsub("^\\s+|\\s+$"; "")) != "true") and ((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "scope" and ((.metadata["gc.kind"] // "") | gsub("^\\s+|\\s+$"; "")) != "spec")] | [.[] | select((((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2")) | not)] + [.[] | select(((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2"))]'\'' 2>/dev/null); [ -n "$gc_preferred_pool_demand" ] && r="$gc_preferred_pool_demand"; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_candidates=$(bd ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --sort oldest --limit=20) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd ready failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true"))] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_ephemeral_candidates=$(printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; probe_pool_demand "$1"; probe_pool_demand "$2"; printf "[]"' -- rig/control-dispatcher rig/workflow-control