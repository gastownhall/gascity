sh -c 'case "$GC_SESSION_ORIGIN" in ephemeral|"") ;; *) [ -n "$GC_ALIAS" ] && [ "$1" = "$GC_ALIAS" ] || exit 0 ;; esac; probe_pool_demand() { target="$1"; [ -z "$target" ] && return 1; r=$(gc ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --limit=20) || exit $?; gc_preferred_pool_demand=$(printf "%s" "$r" | jq -c '\''[.[] | select((((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2")) | not)] + [.[] | select(((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.formula_contract"] // "") == "graph.v2"))]'\'' 2>/dev/null); [ -n "$gc_preferred_pool_demand" ] && r="$gc_preferred_pool_demand"; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_candidates=$(gc ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "human" --json --sort oldest --limit=20) || exit $?; r=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true"))] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; legacy_ephemeral_candidates=$(printf "[]"); r=$(printf "%s" "$legacy_ephemeral_candidates" | jq '\''.[0:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; return 1; }; probe_pool_demand "$1"; if bd_probe_err=$(bd list --limit=1 --json 2>&1 >/dev/null); then printf "[]"; else printf "hook check failed: refusing to report an empty hook because bd is broken: %s\n" "$bd_probe_err" >&2; exit 97; fi' -- worker-pool