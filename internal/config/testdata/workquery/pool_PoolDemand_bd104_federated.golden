sh -c 'target="$1"; ready_json=$(gc ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-type=message --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit 0) || exit $?; legacy_candidates=$(gc ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-type=message --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((.metadata["gc.routed_to"] // "") == "")]'\'') || exit $?; legacy_ephemeral_json=$({ bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 | jq --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "")'\''; } || printf "[]"); printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s "(add // []) | unique_by(.id) | length"' -- worker-pool