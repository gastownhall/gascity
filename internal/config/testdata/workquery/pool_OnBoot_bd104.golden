template='worker-pool'; exec 3>&1; { if r=$(bd list --metadata-field "gc.routed_to=$template" --status=in_progress --no-assignee --json 2>/dev/null); then printf '%s\n' "$r" | jq -r '.[].id' 2>/dev/null; else printf 'gc-recovery: on_boot read failed: bd list gc.routed_to (exit %s)\n' "$?" >&3; fi; if r=$(bd list --metadata-field "gc.run_target=$template" --metadata-field "gc.kind=workflow" --status=in_progress --no-assignee --json 2>/dev/null); then printf '%s\n' "$r" | jq -r '.[] | select((.metadata["gc.routed_to"] // "") == "") | .id' 2>/dev/null; else printf 'gc-recovery: on_boot read failed: bd list gc.run_target (exit %s)\n' "$?" >&3; fi; if r=$(bd query --json 'ephemeral=true AND status=in_progress' --limit=0 2>/dev/null); then printf '%s\n' "$r" | jq -r --arg template "$template" '.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $template) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $template) and ((.metadata["gc.kind"] // "") == "workflow"))) | .id' 2>/dev/null; else printf 'gc-recovery: on_boot read failed: bd query (exit %s)\n' "$?" >&3; fi; } | awk 'NF && !seen[$0]++' | xargs -rI{} sh -c 'if ! err=$(bd update "$1" --status open 2>&1 >/dev/null); then printf "gc-recovery: on_boot reopen failed for %s: %s\n" "$1" "$err"; fi' _ {}