sh -c 'gc_read_assigned_batch() { set --; for gc_identity in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$gc_identity" ] && continue; case "$gc_identity" in *[![:space:]]*) ;; *) continue ;; esac; set -- "$@" "--assignee-any=$gc_identity"; done; [ "$#" -gt 0 ] || { printf "[]"; return 0; }; gc ready --include-ephemeral --exclude-label "hold:mayor" --exclude-label "hold:external" "$@" --json --limit=0; }; gc_assigned_ready_all_json=$(gc_read_assigned_batch) || exit $?; gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; case "$id" in *[![:space:]]*) ;; *) continue ;; esac; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; r=$(printf "%s" "$gc_assigned_ready_all_json" | jq --arg id "$id" '\''[.[] | select((.assignee // "") == $id)] | .[:1]'\'' 2>/dev/null); [ -z "$r" ] && r="$gc_assigned_ready_all_json"; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; printf "[]"'