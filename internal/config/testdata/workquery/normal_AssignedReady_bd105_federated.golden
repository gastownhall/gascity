sh -c 'gc_assigned_ready_json=$(gc ready --include-ephemeral --assignee="$GC_SESSION_ID" --assignee="$GC_SESSION_NAME" --assignee="$GC_ALIAS" --json --limit=0) || exit $?; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; r=$(printf "%s" "$gc_assigned_ready_json" | jq -c --arg id "$id" '\''[.[] | select((.assignee // "") == $id)] | .[:1]'\'') || exit $?; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; printf "[]"'