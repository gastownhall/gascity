sh -c 'gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; case "$id" in *[![:space:]]*) ;; *) continue ;; esac; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(gc ready --status in_progress --assignee="$cand" --exclude-label "hold:mayor" --exclude-label "hold:external" --until-unblocked --json --limit=20) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''gc'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''gc ready --status in_progress failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; gc_servable_in_progress=$(printf "%s" "$r" | jq -c '\''[.[] | select(((.blocked_by // []) | [.[] | select(((.status // "") | ascii_downcase) != "closed")] | length) == 0) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0)] | .[:1]'\'' 2>/dev/null); [ -n "$gc_servable_in_progress" ] && r="$gc_servable_in_progress"; if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb=$(printf "%s" "$r" | jq -c '\''.[0].blocked_by // empty'\'' 2>/dev/null); [ "$bb" = "null" ] && bb=""; if [ -z "$bb" ]; then bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); fi; [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; nheld=$(printf "%s" "$r" | jq -r '\''[ (.[0].labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length'\'' 2>/dev/null); [ -z "$nheld" ] && nheld=0; if [ "$nblocked" = "0" ] && [ "$nheld" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; [ -n "${in_progress_ephemeral_set:-}" ] || { in_progress_ephemeral=$(bd query --json '\''ephemeral=true AND status=in_progress'\'' --limit=0) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; printf "%s" "$in_progress_ephemeral" | jq empty >/dev/null 2>&1 || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''jq'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query output is not valid JSON'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; in_progress_ephemeral_set=1; }; r=$(printf "%s" "$in_progress_ephemeral" | jq --arg id "$cand" '\''[.[] | select((.assignee // "") == $id) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0)] | .[:1]'\'' 2>/dev/null); if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; if [ "$nblocked" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; done; done; printf "[]"'