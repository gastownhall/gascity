sh -c 'gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; case "$id" in *[![:space:]]*) ;; *) continue ;; esac; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; r=$(bd ready --assignee="$id" --json --limit=1) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd ready failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; [ -n "${open_ephemeral_set:-}" ] || { open_ephemeral=$(bd query --json '\''ephemeral=true AND status=open'\'' --limit=0) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; printf "%s" "$open_ephemeral" | jq empty >/dev/null 2>&1 || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''jq'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query output is not valid JSON'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; open_ephemeral_set=1; }; r=$(printf "%s" "$open_ephemeral" | jq --arg id "$id" '\''[.[] | select((.assignee // "") == $id) | select(((.issue_type // .type // "") != "epic")) | select(((.issue_type // .type // "") | tostring | gsub("^\\s+|\\s+$"; "") | ascii_downcase) != "message") | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "") | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; r=$(printf "%s" "$open_ephemeral" | jq --arg id "$id" '\''[.[] | select((.assignee // "") == $id) | select(((.issue_type // .type // "") != "epic")) | select(((.issue_type // .type // "") | tostring | gsub("^\\s+|\\s+$"; "") | ascii_downcase) != "message") | select(((.dependency_count // 0) > 0))] | sort_by(.created_at // "", .id // "") | .[:1]'\'' 2>/dev/null); if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; if [ "$nblocked" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; done; printf "[]"'