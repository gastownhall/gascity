sh -c 'target="$1"; ready_json=$(gc ready --include-ephemeral --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --limit 0) || exit $?; legacy_candidates=$(gc ready --include-ephemeral --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "scope") and (((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "spec") and ((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "workflow") or ((((.metadata["gc.workflow_expanded"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "true") and ((((.metadata // {}) | has("gc.native_step_dependencies.v1")) and (((.metadata["gc.native_step_dependencies.v1"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "[]")) or ((((.metadata // {}) | has("gc.native_step_dependencies.v1")) | not) and ((((.metadata["gc.formula_contract"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "graph.v2") or (((.metadata["gc.routed_to"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "")))))))] | [.[] | select((.metadata["gc.routed_to"] // "") == "")]'\'') || exit $?; legacy_ephemeral_json=$(printf "[]"); printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s '\''(add // []) | [.[] | select((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "scope") and (((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "spec") and ((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "workflow") or ((((.metadata["gc.workflow_expanded"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "true") and ((((.metadata // {}) | has("gc.native_step_dependencies.v1")) and (((.metadata["gc.native_step_dependencies.v1"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "[]")) or ((((.metadata // {}) | has("gc.native_step_dependencies.v1")) | not) and ((((.metadata["gc.formula_contract"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) != "graph.v2") or (((.metadata["gc.routed_to"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) == "")))))))] | unique_by(.id) | length'\''' -- rig/control-dispatcher