sh -c 'gc_workflow_work_done() { gc_wf_closed=$(bd list --metadata-field "gc.root_bead_id=$1" --status=closed --json --limit=20) || return 1; gc_wf_ran=$(printf "%s" "$gc_wf_closed" | jq -rs --arg root "$1" '\''if length == 0 or any(.[]; type != "array") then error("workflow member read is not a JSON array") else any(.[][]; (.id // "") != $root and ((.status // "") | tostring | ascii_downcase) == "closed" and ((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) as $gc_kind | $gc_kind == "workflow" or $gc_kind == "scope" or $gc_kind == "spec") | not)) end'\'' 2>/dev/null) || return 1; [ "$gc_wf_ran" = "true" ] || return 1; gc_wf_open=$(bd list --metadata-field "gc.root_bead_id=$1" --json --limit=20) || return 1; gc_wf_live=$(printf "%s" "$gc_wf_open" | jq -rs --arg root "$1" '\''if length == 0 or any(.[]; type != "array") then error("workflow member read is not a JSON array") else any(.[]; length >= 20) or any(.[][]; (.id // "") != $root and ((.status // "") | tostring | ascii_downcase) != "closed" and ((((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; "")) as $gc_kind | $gc_kind == "scope" or $gc_kind == "spec" or $gc_kind == "workflow-finalize") | not)) end'\'' 2>/dev/null) || return 1; [ "$gc_wf_live" = "false" ]; }; gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; case "$id" in *[![:space:]]*) ;; *) continue ;; esac; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(bd list --status in_progress --assignee="$cand" --json --limit=1) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd list --status in_progress failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; if [ -n "$r" ] && [ "$r" != "[]" ]; then gc_unexcluded=$(printf "%s" "$r" | jq -c '\''if type == "array" and any(.[]; (((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) then [.[] | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] else empty end'\'' 2>/dev/null); [ -n "$gc_unexcluded" ] && r="$gc_unexcluded"; fi; if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; nheld=$(printf "%s" "$r" | jq -r '\''[ (.[0].labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length'\'' 2>/dev/null); [ -z "$nheld" ] && nheld=0; nwfdone=0; if [ "$nblocked" = "0" ] && [ "$nheld" = "0" ] && [ -n "$bid" ]; then gc_wf_kind=$(printf "%s" "$r" | jq -r '\''.[0] | ((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; ""))'\'' 2>/dev/null); if [ "$gc_wf_kind" = "workflow" ] && gc_workflow_work_done "$bid"; then nwfdone=1; fi; fi; if [ "$nblocked" = "0" ] && [ "$nheld" = "0" ] && [ "$nwfdone" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; [ -n "${in_progress_ephemeral_set:-}" ] || { in_progress_ephemeral=$(bd query --json '\''ephemeral=true AND status=in_progress'\'' --limit=0) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''bd'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; printf "%s" "$in_progress_ephemeral" | jq empty >/dev/null 2>&1 || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''jq'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''bd query output is not valid JSON'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; in_progress_ephemeral_set=1; }; r=$(printf "%s" "$in_progress_ephemeral" | jq --arg id "$cand" '\''[.[] | select((.assignee // "") == $id) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0) | select(((.issue_type // .type // "") | tostring | gsub("^\\s+|\\s+$"; "") | ascii_downcase) != "message") | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] | .[:1]'\'' 2>/dev/null); if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; nwfdone=0; if [ "$nblocked" = "0" ] && [ -n "$bid" ]; then gc_wf_kind=$(printf "%s" "$r" | jq -r '\''.[0] | ((.metadata["gc.kind"] // "") | tostring | gsub("^\\s+|\\s+$"; ""))'\'' 2>/dev/null); if [ "$gc_wf_kind" = "workflow" ] && gc_workflow_work_done "$bid"; then nwfdone=1; fi; fi; if [ "$nblocked" = "0" ] && [ "$nwfdone" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; done; done; printf "[]"'