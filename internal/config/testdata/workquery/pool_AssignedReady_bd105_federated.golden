sh -c 'gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; r=$(gc ready --include-ephemeral --assignee="$id" --json --limit=1) || exit $?; nheld=$(printf "%s" "$r" | jq -r '\''[ (.[0].labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length'\'' 2>/dev/null); [ -z "$nheld" ] && nheld=0; [ -n "$r" ] && [ "$r" != "[]" ] && [ "$nheld" = "0" ] && printf "%s" "$r" && exit 0; done; printf "[]"'