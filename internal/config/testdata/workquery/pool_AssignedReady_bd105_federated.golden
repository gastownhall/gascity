sh -c 'gc_id_seen1=""; gc_id_seen2=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; case "$id" in *[![:space:]]*) ;; *) continue ;; esac; [ "$id" = "$gc_id_seen1" ] && continue; [ "$id" = "$gc_id_seen2" ] && continue; if [ -z "$gc_id_seen1" ]; then gc_id_seen1="$id"; else gc_id_seen2="$id"; fi; r=$(gc ready --include-ephemeral --assignee="$id" --json --limit=1) || { gc_rc=$?; if [ "$gc_rc" = 127 ]; then printf "gc work query: %s not found in PATH\n" '\''gc'\'' >&2; else printf "gc work query: %s (exit %s)\n" '\''gc ready failed'\'' "$gc_rc" >&2; fi; exit "$gc_rc"; }; if [ -n "$r" ] && [ "$r" != "[]" ]; then gc_unexcluded=$(printf "%s" "$r" | jq -c '\''if type == "array" and any(.[]; (((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) then [.[] | select(((((.metadata["gc.exclude_claimants"] // "") | tostring | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $gc_ex | [$ENV.GC_SESSION_ID, $ENV.GC_SESSION_NAME, $ENV.GC_ALIAS, $ENV.GC_AGENT] | any(.[]; (. // "") as $gc_id | $gc_id != "" and any($gc_ex[]; . == $gc_id)))) | not)] else empty end'\'' 2>/dev/null); [ -n "$gc_unexcluded" ] && r="$gc_unexcluded"; fi; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; printf "[]"'