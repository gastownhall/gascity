sh -c 'gc_legacy_session_id=""; case "$GC_SESSION_ID" in *control-dispatcher) gc_legacy_session_id="${GC_SESSION_ID%control-dispatcher}workflow-control";; esac; gc_legacy_session_name=""; case "$GC_SESSION_NAME" in *control-dispatcher) gc_legacy_session_name="${GC_SESSION_NAME%control-dispatcher}workflow-control";; esac; gc_legacy_alias=""; case "$GC_ALIAS" in *control-dispatcher) gc_legacy_alias="${GC_ALIAS%control-dispatcher}workflow-control";; esac; gc_assigned_ready_json=$(gc ready --include-ephemeral --assignee="$GC_SESSION_ID" --assignee="$gc_legacy_session_id" --assignee="$GC_SESSION_NAME" --assignee="$gc_legacy_session_name" --assignee="$GC_ALIAS" --assignee="$gc_legacy_alias" --json --limit=0) || exit $?; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(printf "%s" "$gc_assigned_ready_json" | jq -c --arg id "$cand" '\''[.[] | select((.assignee // "") == $id)] | .[:1]'\'') || exit $?; [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; done; printf "[]"'