sh -c 'gc_seen_id_1_set=""; gc_seen_id_2_set=""; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; [ -n "$gc_seen_id_1_set" ] && [ "$id" = "$gc_seen_id_1" ] && continue; [ -n "$gc_seen_id_2_set" ] && [ "$id" = "$gc_seen_id_2" ] && continue; if [ -z "$gc_seen_id_1_set" ]; then gc_seen_id_1="$id"; gc_seen_id_1_set=1; else gc_seen_id_2="$id"; gc_seen_id_2_set=1; fi; r=$(bd ready --include-ephemeral --assignee="$id" --json --limit=1 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; printf "[]"'