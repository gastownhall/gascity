load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "acp",
    srcs = [
        "acp.go",
        "activity_publisher.go",
        "conn.go",
        "cutover.go",
        "events.go",
        "protocol.go",
        "seams.go",
        "turn_events.go",
        "turns.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/acp",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/fsys",
        "//internal/runtime",
    ],
)

go_test(
    name = "acp_test",
    srcs = [
        "acp_test.go",
        "activity_test.go",
        "events_test.go",
        "meta_privacy_test.go",
        "protocol_test.go",
        "seams_test.go",
        "testenv_import_test.go",
        "turn_events_test.go",
        "turns_test.go",
    ],
    embed = [":acp"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/auto",
        "//internal/runtime/hybrid",
        "//internal/testenv",
        "//internal/testutil",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
