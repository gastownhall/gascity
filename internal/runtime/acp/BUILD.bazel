load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "acp",
    srcs = [
        "acp.go",
        "activity_publisher.go",
        "conn.go",
        "cutover.go",
        "lifecycle_lock.go",
        "proctable.go",
        "protocol.go",
        "seams.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/acp",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/fsys",
        "//internal/runtime",
        "//internal/runtime/proctable",
    ],
)

go_test(
    name = "acp_test",
    srcs = [
        "acp_test.go",
        "activity_test.go",
        "capacity_test.go",
        "conformance_test.go",
        "meta_privacy_test.go",
        "pipe_error_test.go",
        "proctable_integration_test.go",
        "proctable_linux_test.go",
        "protocol_conformance_test.go",
        "protocol_test.go",
        "seams_test.go",
        "socket_probe_test.go",
        "startup_test.go",
        "stop_grace_test.go",
        "testenv_import_test.go",
    ],
    data = select({
        "//:gotags_integration": [
            "//internal/runtime/acp/testdata/fakeacp",
        ],
        "//conditions:default": [],
    }),
    embed = [":acp"],
    # The integration conformance suites exec the built fake agent.
    env = select({
        "//:gotags_integration": {
            "GC_TEST_FAKEACP_BIN": "$(rootpath //internal/runtime/acp/testdata/fakeacp)",
        },
        "//conditions:default": {},
    }),
    deps = [
        "//internal/bazeltest",
        "//internal/runtime",
        "//internal/runtime/runtimetest",
        "//internal/testenv",
        "//internal/testutil",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/runtime/proctable",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/runtime/proctable",
        ],
        "//conditions:default": [],
    }),
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
