load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "hybrid",
    srcs = ["hybrid.go"],
    importpath = "github.com/gastownhall/gascity/internal/runtime/hybrid",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/runtime"],
)

go_test(
    name = "hybrid_test",
    srcs = [
        "conformance_test.go",
        "hybrid_test.go",
        "testenv_import_test.go",
    ],
    embed = [":hybrid"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/runtimetest",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
