load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runtimecapability",
    srcs = [
        "catalog.go",
        "probes.go",
        "report.go",
        "runner.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/runtimecapability",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/runtime"],
)

go_test(
    name = "runtimecapability_test",
    srcs = [
        "runner_test.go",
        "testenv_import_test.go",
    ],
    embed = [":runtimecapability"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
