load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runtimecontract",
    srcs = [
        "catalog.go",
        "observe.go",
        "probes.go",
        "report.go",
        "runner.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/runtimecontract",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/execenv",
        "//internal/runtime",
        "//internal/runtime/exec",
    ],
)

go_test(
    name = "runtimecontract_test",
    srcs = [
        "lockstep_test.go",
        "runner_test.go",
        "screen_reference_test.go",
        "screen_script_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//contrib:all_files",
        "//internal/runtime/runtimetest:conformance.go",
    ],
    embed = [":runtimecontract"],
    deps = [
        "//internal/bazeltest",
        "//internal/runtime/runtimecontract/reference",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
