load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tmux",
    srcs = [
        "adapter.go",
        "agent_slice.go",
        "composer_clear.go",
        "cutover.go",
        "interaction.go",
        "process_group_unix.go",
        "process_group_windows.go",
        "process_signal.go",
        "seams.go",
        "server_socket_probe.go",
        "server_socket_probe_darwin.go",
        "server_socket_probe_linux.go",
        "server_socket_probe_other.go",
        "session_env_file.go",
        "session_object.go",
        "state_cache.go",
        "theme.go",
        "tmux.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/tmux",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/citylayout",
        "//internal/execgrace",
        "//internal/overlay",
        "//internal/processenv",
        "//internal/runtime",
        "//internal/runtime/proctable",
        "//internal/sessionlog",
        "//internal/shellquote",
        "@org_golang_x_sync//singleflight",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

