load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "exec",
    srcs = [
        "cutover.go",
        "exec.go",
        "handshake.go",
        "json.go",
        "seams.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/exec",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/execgrace",
        "//internal/runtime",
    ],
)

go_test(
    name = "exec_test",
    srcs = [
        "cutover_test.go",
        "exec_connection_test.go",
        "exec_reuse_test.go",
        "exec_test.go",
        "handshake_test.go",
        "json_test.go",
        "seams_test.go",
        "testenv_import_test.go",
    ],
    embed = [":exec"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/runtimetest",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
