load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "auto",
    srcs = [
        "auto.go",
        "proctable.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/auto",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/runtime"],
)

go_test(
    name = "auto_test",
    srcs = [
        "auto_test.go",
        "composite_forward_test.go",
        "conformance_test.go",
        "corpse_fallthrough_test.go",
        "liveness_forwarding_test.go",
        "proctable_forwarding_test.go",
        "router_test.go",
        "session_events_test.go",
        "testenv_import_test.go",
    ],
    embed = [":auto"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/hybrid",
        "//internal/runtime/runtimetest",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
