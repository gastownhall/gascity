load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "auto",
    srcs = ["auto.go"],
    importpath = "github.com/gastownhall/gascity/internal/runtime/auto",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/runtime"],
)

go_test(
    name = "auto_test",
    srcs = [
        "auto_test.go",
        "conformance_test.go",
        "liveness_forwarding_test.go",
        "testenv_import_test.go",
    ],
    embed = [":auto"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/runtimetest",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
