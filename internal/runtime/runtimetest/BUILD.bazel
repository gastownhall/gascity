load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(glob(
    ["*.go"],
    exclude = ["*_test.go"],
))

go_library(
    name = "runtimetest",
    srcs = ["conformance.go"],
    importpath = "github.com/gastownhall/gascity/internal/runtime/runtimetest",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/runtime"],
)

go_test(
    name = "runtimetest_test",
    srcs = [
        "conformance_test.go",
        "testenv_import_test.go",
    ],
    embed = [":runtimetest"],
    deps = [
        "//internal/runtime",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
