load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workrecord",
    srcs = [
        "gate.go",
        "repo_dir.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/workrecord",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beadmeta",
        "//internal/beads",
        "//internal/storeref",
    ],
)

go_test(
    name = "workrecord_test",
    srcs = [
        "gate_test.go",
        "repo_dir_test.go",
        "testenv_import_test.go",
    ],
    embed = [":workrecord"],
    deps = [
        "//internal/beadmeta",
        "//internal/beads",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
