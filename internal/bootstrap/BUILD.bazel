load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "bootstrap",
    srcs = glob(["*.go"]),
    importpath = "github.com/gastownhall/gascity/internal/bootstrap",
    visibility = ["//:__subpackages__"],
    deps = ["@com_github_burntsushi_toml//:toml"],
)

go_test(
    name = "bootstrap_test",
    srcs = [
        "bootstrap_test.go",
        "collision_test.go",
        "core_formula_report_test.go",
        "home_fallback_test.go",
        "pack_formula_graphv2_test.go",
        "testenv_import_test.go",
    ],
    embed = [":bootstrap"],
    deps = [
        "//internal/formula",
        "//internal/testenv",
    ],
)
