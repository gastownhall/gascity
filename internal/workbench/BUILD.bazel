load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "workbench",
    srcs = ["diff.go"],
    importpath = "github.com/gastownhall/gascity/internal/workbench",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "workbench_test",
    srcs = [
        "diff_test.go",
        "testenv_import_test.go",
    ],
    embed = [":workbench"],
    deps = [
        "//internal/testenv",
        "//internal/testutil",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
