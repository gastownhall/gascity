load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sessiontest",
    srcs = ["sessiontest.go"],
    importpath = "github.com/gastownhall/gascity/internal/session/sessiontest",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beads",
        "//internal/session",
    ],
)

go_test(
    name = "sessiontest_test",
    srcs = [
        "sessiontest_test.go",
        "testenv_import_test.go",
    ],
    deps = [
        ":sessiontest",
        "//internal/beads",
        "//internal/session",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
