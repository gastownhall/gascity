load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "mailtest",
    srcs = ["conformance.go"],
    importpath = "github.com/gastownhall/gascity/internal/mail/mailtest",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/mail"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
