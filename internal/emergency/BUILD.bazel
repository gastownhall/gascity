load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "emergency",
    srcs = ["emergency.go"],
    importpath = "github.com/gastownhall/gascity/internal/emergency",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/citylayout",
        "//internal/events",
    ],
)

go_test(
    name = "emergency_test",
    srcs = [
        "emergency_test.go",
        "testenv_import_test.go",
    ],
    embed = [":emergency"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
