load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lease",
    srcs = ["lease.go"],
    importpath = "github.com/gastownhall/gascity/internal/lease",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "lease_test",
    srcs = [
        "lease_property_test.go",
        "lease_test.go",
        "testenv_import_test.go",
    ],
    embed = [":lease"],
    deps = [
        "//internal/testenv",
        "@net_pgregory_rapid//:rapid",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
