load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "doltorphan",
    srcs = ["sweep.go"],
    importpath = "github.com/gastownhall/gascity/internal/doltorphan",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/clock"],
)

go_test(
    name = "doltorphan_test",
    srcs = [
        "sweep_test.go",
        "testenv_import_test.go",
    ],
    embed = [":doltorphan"],
    deps = [
        "//internal/clock",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
