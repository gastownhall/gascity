go_test(
    name = "productmetrics_test",
    # The suite is fsync-bound by design: storage syncs a directory after every
    # entry it unlinks, so the tests make about 62,000 fsyncs, six of them
    # 1,500 to 5,100 each. Every one waits on the disk under the sandbox's
    # hermetic /tmp. A loaded gate host took 180 s for one 5,046-fsync test,
    # and both shards of the old 2-shard split overran 300 s (ga-46vdxg). Six
    # shards keep the heaviest tests apart; the long timeout covers a gate
    # host slower than the one measured.
    timeout = "long",
    srcs = [
        "config_state_test.go",
        "control_unix_test.go",
        "event_test.go",
        "hangbudget_test.go",
        "marker_protocol_unix_test.go",
        "notice_state_unix_test.go",
        "pause_allocation_test.go",
        "pause_test.go",
        "platform_unsupported_test.go",
        "quota_test.go",
        "record_incarnation_unix_test.go",
        "release_test.go",
        "s3_privacy_stale_enable_test.go",
        "service_state_unix_test.go",
        "service_state_unsupported_test.go",
        "spawn_close_unix_test.go",
        "spawn_test.go",
        "spawn_unix_test.go",
        "spool_unix_test.go",
        "state_namespace_unix_test.go",
        "status_reason_schema_test.go",
        "status_test.go",
        "status_unix_test.go",
        "status_writer_unix_test.go",
        "storage_test.go",
        "storage_unix_test.go",
        "storage_write_outcome_unix_test.go",
        "testenv_import_test.go",
        "transport_test.go",
        "upload_test.go",
        "uploader_unix_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    embed = [":productmetrics"],
    shard_count = 6,
    deps = [
        "//:gascity",
        "//internal/testenv",
    ] + select({
        "@rules_go//go/platform:aix": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:android": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:darwin": [
            "//internal/bazeltest",
            "//internal/gchome",
            "//internal/testutil",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:dragonfly": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:freebsd": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:illumos": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:ios": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:js": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/bazeltest",
            "//internal/gchome",
            "//internal/testutil",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:netbsd": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:openbsd": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:osx": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:plan9": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:qnx": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:solaris": [
            "//internal/gchome",
        ],
        "@rules_go//go/platform:windows": [
            "//internal/gchome",
        ],
        "//conditions:default": [],
    }),
)

