load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "beadmeta",
    srcs = [
        "attempt.go",
        "control_close.go",
        "hold_labels.go",
        "keys.go",
        "keyshape.go",
        "kindsets.go",
        "path.go",
        "reserved_prefixes.go",
        "runid.go",
        "values.go",
        "workflow_root.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/beadmeta",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "beadmeta_test",
    srcs = [
        "attempt_test.go",
        "control_close_test.go",
        "guard_test.go",
        "hold_labels_test.go",
        "keys_test.go",
        "kindsets_test.go",
        "leaf_test.go",
        "merge_strategy_test.go",
        "path_test.go",
        "reserved_prefixes_test.go",
        "runid_test.go",
        "testenv_import_test.go",
        "values_test.go",
        "workflow_root_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//:repo_go_srcs",
    ],
    embed = [":beadmeta"],
    deps = [
        "//internal/bazeltest",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
