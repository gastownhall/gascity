load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cityinit",
    srcs = [
        "cityinit.go",
        "config.go",
        "layout.go",
        "ports.go",
        "rollback.go",
        "service.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/cityinit",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/citylayout",
        "//internal/config",
        "//internal/fsys",
    ],
)

go_test(
    name = "cityinit_test",
    srcs = [
        "layout_test.go",
        "no_io_boundary_test.go",
        "scaffold_fs_test.go",
        "service_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//:repo_source_tree",
    ],
    embed = [":cityinit"],
    deps = [
        "//internal/bazeltest",
        "//internal/citylayout",
        "//internal/fsys",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
