load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "orderdiscovery",
    srcs = ["discovery.go"],
    importpath = "github.com/gastownhall/gascity/internal/orderdiscovery",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/citylayout",
        "//internal/config",
        "//internal/fsys",
        "//internal/orders",
    ],
)

go_test(
    name = "orderdiscovery_test",
    srcs = [
        "discovery_test.go",
        "testenv_import_test.go",
    ],
    embed = [":orderdiscovery"],
    deps = [
        "//internal/config",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
