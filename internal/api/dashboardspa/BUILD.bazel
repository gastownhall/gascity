load("@bazel_lib//lib:copy_directory.bzl", "copy_directory")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# dist/, as embed.go's `//go:embed all:dist` names it, from the Bazel build.
copy_directory(
    name = "dist",
    src = "//internal/api/dashboardspa/web/frontend:build",
    out = "dist",
)

# The committed dist/ (what a Node-less `go build` embeds) must be exactly the
# bundle the sources build to: byte-for-byte, file-for-file.
copy_to_directory(
    name = "committed_dist",
    srcs = glob(["dist/**"]),
    root_paths = ["internal/api/dashboardspa/dist"],
)

diff_test(
    name = "dist_in_sync_test",
    failure_message = "internal/api/dashboardspa/dist/ is stale: run make dashboard-build and commit the result.",
    file1 = ":committed_dist",
    file2 = ":dist",
)

go_library(
    name = "dashboardspa",
    srcs = [
        "embed.go",
        "handler.go",
    ],
    # The SPA bundle built by Bazel (vite under rules_js), not the committed
    # dist/ copy: //cmd/gc embeds what the sources build to. dist_in_sync_test
    # keeps the committed copy (what a Node-less `go build` embeds) identical.
    embedsrcs = [":dist"],  # keep
    importpath = "github.com/gastownhall/gascity/internal/api/dashboardspa",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "dashboardspa_test",
    srcs = [
        "handler_test.go",
        "testenv_import_test.go",
    ],
    embed = [":dashboardspa"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
