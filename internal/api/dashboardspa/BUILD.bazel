load("@bazel_lib//lib:copy_directory.bzl", "copy_directory")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# JavaScript tooling executes on the build worker even when the Go binary
# targets another OS. Keep native optional dependencies (Rollup, esbuild) in
# that execution platform configuration; the generated SPA is platform neutral.
platform_transition_filegroup(
    name = "worker_dist",
    srcs = ["//internal/api/dashboardspa/web/frontend:build"],
    target_platform = "//platforms:rbe_worker",
)

# Raw canonical dist from the Bazel frontend build.
copy_directory(
    name = "dist",
    src = ":worker_dist",
    out = "dist",
)

# Raw canonical dist must remain exactly the bundle the sources build to:
# byte-for-byte, file-for-file.
copy_to_directory(
    name = "committed_dist",
    srcs = glob(["dist/**"]),
    root_paths = ["internal/api/dashboardspa/dist"],
)

diff_test(
    name = "dist_in_sync_test",
    failure_message = "internal/api/dashboardspa/dist/ is stale: run make dashboard-build and commit the result.",
    file1 = ":committed_dist",
    file2 = ":dist",
)

# One deterministic compressed representation of the same canonical assets.
py_binary(
    name = "pack_assets",
    srcs = ["pack_assets.py"],
)

genrule(
    name = "asset_bundle",
    srcs = [":dist"],
    outs = ["generated/dist.bundle.json.gz"],
    # Bazel exposes declared tree artifacts via sandbox symlinks. Materialize
    # only this declared tree before the packer enforces its source-input rule.
    cmd = "mkdir -p '$(@D)/asset-bundle-input' && cp -RL '$(location :dist)/.' '$(@D)/asset-bundle-input/' && $(location :pack_assets) --input '$(@D)/asset-bundle-input' --output '$@'",
    tools = [":pack_assets"],
)

copy_to_directory(
    name = "embedded",
    srcs = [":asset_bundle"],
    out = "embedded",
    root_paths = ["internal/api/dashboardspa/generated"],
)

py_test(
    name = "pack_assets_test",
    srcs = [
        "pack_assets.py",
        "pack_assets_test.py",
    ],
    imports = ["."],
)

copy_to_directory(
    name = "committed_packed_dist",
    srcs = glob(["embedded/**"]),
    root_paths = ["internal/api/dashboardspa/embedded"],
)

# Compare canonical manifests: gzip headers are fixed, and zlib implementation
# differences must not obscure exact uncompressed asset equivalence.
py_test(
    name = "packed_dist_in_sync_test",
    srcs = ["packed_dist_sync_test.py"],
    args = [
        "--committed=$(rootpath :committed_packed_dist)",
        "--generated=$(rootpath :embedded)",
    ],
    data = [
        ":committed_packed_dist",
        ":embedded",
    ],
    main = "packed_dist_sync_test.py",
)

go_library(
    name = "dashboardspa",
    srcs = [
        "compressed_fs.go",
        "embed.go",
        "handler.go",
    ],
    # Production embeds only compressed storage. Canonical raw dist remains
    # covered by dist_in_sync_test and test-only embeds for byte equivalence.
    embedsrcs = [":embedded"],  # keep
    importpath = "github.com/gastownhall/gascity/internal/api/dashboardspa",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "dashboardspa_test",
    srcs = [
        "asset_equivalence_test.go",
        "compressed_fs_test.go",
        "handler_test.go",
        "testenv_import_test.go",
    ],
    embed = [":dashboardspa"],
    embedsrcs = [":dist"],  # keep
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
