    name = "apicontract",
    srcs = [
        "apicontract.go",
        "coverage.go",
        "transport.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/api/apicontract",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_pb33f_libopenapi//:libopenapi",
