load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "testutil",
    srcs = [
        "failure_artifacts.go",
        "git.go",
        "path.go",
        "timeout.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/testutil",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/pathutil"],
)

go_test(
    name = "testutil_test",
    srcs = [
        "path_test.go",
        "testenv_import_test.go",
    ],
    embed = [":testutil"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
