load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "providerledger",
    srcs = [
        "guard.go",
        "ledger.go",
        "proof.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/testutil/providerledger",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/bazeltest",
        "//internal/testpolicy/waiverclock",
    ],
)

go_test(
    name = "providerledger_test",
    srcs = [
        "ledger_test.go",
        "testenv_import_test.go",
        "waiver_clock_test.go",
        "waiver_owner_test.go",
        "waiver_stagger_test.go",
    ],
    data = [
        "//:go.mod",
        "//:repo_source_tree",
        "@go_sdk//:srcs",
    ],
    embed = [":providerledger"],
    deps = [
        "//internal/bazeltest",
        "//internal/testenv",
        "//internal/testpolicy/waiverclock",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
