load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "genshelltest",
    srcs = ["genshelltest.go"],
    importpath = "github.com/gastownhall/gascity/internal/genshell/genshelltest",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/genshell"],
)

go_test(
    name = "genshelltest_test",
    srcs = [
        "genshelltest_test.go",
        "testenv_import_test.go",
    ],
    embed = [":genshelltest"],
    deps = [
        "//internal/genshell",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
