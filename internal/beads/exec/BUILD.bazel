load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "exec",
    srcs = [
        "exec.go",
        "json.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/beads/exec",
    visibility = ["//:__subpackages__"],
