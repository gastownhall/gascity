)

go_test(
    name = "exec_test",
    srcs = [
        "br_script_test.go",
        "exec_test.go",
        "idprefix_test.go",
        "testenv_import_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":exec"],
    deps = [
        "//internal/beads",
        "//internal/beads/beadstest",
        "//internal/testenv",
    ],
