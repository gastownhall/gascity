# The native DoltLite read-store suite (`make test-native-doltlite-beads`):
# beads_test built with -tags gascity_native_beads, running the TestDoltlite*
# tests. With cgo: the Makefile's CGO_ENABLED=0 drops the cgo-only embedded
# Dolt files and with them their imports, but gazelle's deps are
# cgo-unconditional, so a pure build here would still compile Dolt's
# cgo-only go-icu-regex and fail. The store's sqlite driver is pure Go
# (modernc.org/sqlite) either way.
go_variant_test(
    name = "beads_native_doltlite_test",
    args = ["-test.run=^TestDoltlite"],
    gotags = ["gascity_native_beads"],
    test = ":beads_test",
)

# The ReleaseIfCurrent CAS contract against a real bd
# (`make test-bd-conditional-release-contract`): beads_test built with
# -tags integration, with deps.env BD_CURRENT_REF's bd (the v1.3.1 tag,
# @bd_bin_v1_3_1) first on PATH (GC_TEST_TOOL_PATHS, internal/testenv).
# GC_REQUIRE_BD_CONDITIONAL_RELEASE=1 turns the row's capability skip into a
# failure. The integration-packages lane also runs the row (without that
# switch); this target is the strict cell, and runs for fork PRs too.
go_variant_test(
    name = "bd_conditional_release_contract_test",
    args = ["-test.run=^TestBdStoreReleaseIfCurrentAgainstRealBd$$"],
    data = ["@bd_bin_v1_3_1//:bd"],
    env = {
        "GC_REQUIRE_BD_CONDITIONAL_RELEASE": "1",
        "GC_TEST_TOOL_PATHS": "$(rootpath @bd_bin_v1_3_1//:bd)",
    },
    gotags = ["integration"],
    test = ":beads_test",
)

# scripts/bd_contract_pins_test.go pins bd_conditional_release_contract_test.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//scripts:__pkg__"],
)

