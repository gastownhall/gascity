load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "splittest",
    srcs = [
        "callsite.go",
        "gate.go",
        "native_work_store.go",
        "pinned_id_fence.go",
        "projection.go",
        "ratchet.go",
        "semantics.go",
        "split_stores.go",
        "split_violation.go",
        "strict_store.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/beads/splittest",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beads",
        "//internal/config",
        "//internal/coordclass",
        "//internal/storeref",
    ],
)

go_test(
    name = "splittest_test",
    srcs = [
        "callsite_test.go",
        "federated_marker_guard_test.go",
        "fence_conformance_test.go",
        "import_boundary_test.go",
        "projection_guard_test.go",
        "projection_test.go",
        "ratchet_test.go",
        "split_stores_test.go",
        "strict_read_test.go",
        "strict_store_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//:repo_go_srcs",
    ],
    embed = [":splittest"],
    deps = [
        "//internal/bazeltest",
        "//internal/beads",
        "//internal/beads/beadstest",
        "//internal/config",
        "//internal/convoy",
        "//internal/coordclass",
        "//internal/mail/beadmail",
        "//internal/storeref",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
