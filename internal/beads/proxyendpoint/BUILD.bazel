load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "proxyendpoint",
    srcs = [
        "birth.go",
        "birth_linux.go",
        "birth_other.go",
        "idle.go",
        "liveness.go",
        "poolkey.go",
        "post_open.go",
        "probe.go",
        "probe_testing.go",
        "record.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/beads/proxyendpoint",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beads/contract",
        "//internal/fsys",
        "//internal/pathutil",
        "//internal/pidutil",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

go_test(
    name = "proxyendpoint_test",
    srcs = [
        "birth_linux_test.go",
        "birth_test.go",
        "idle_test.go",
        "liveness_test.go",
        "poolkey_test.go",
        "post_open_test.go",
        "probe_cursor_reality_test.go",
        "probe_session_test.go",
        "probe_test.go",
        "record_test.go",
        "testenv_import_test.go",
    ],
    data = [
        "//:go.mod",
        "//:repo_go_srcs",
    ],
    embed = [":proxyendpoint"],
    deps = [
        "//internal/bazeltest",
        "//internal/beads/contract",
        "//internal/beads/proxyendpoint/proxyendpointtest",
        "//internal/doltpool",
        "//internal/fsys",
        "//internal/testenv",
        "@com_github_go_sql_driver_mysql//:mysql",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
