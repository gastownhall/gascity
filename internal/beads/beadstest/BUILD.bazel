load("@rules_go//go:def.bzl", "go_library", "go_test")

# pinned_module_hostcache_test.go resolves the module cache this test binary was
# linked from: it walks up from the working directory for go.mod and reads
# GOMODCACHE/GOPATH/GOENV/HOME. A bazel test sandbox has neither, and the
# resolver is deliberately fatal rather than skipping, so the file is retained in
# the Go package suite and deferred from the hermetic Bazel pilot.
# gazelle:exclude pinned_module_hostcache_test.go

go_library(
    name = "beadstest",
    srcs = [
        "conditional_writer_conformance.go",
        "conformance.go",
        "conformance_skips.go",
        "fence_conformance.go",
        "metadata_cas_conformance.go",
        "pinned_id_fence_conformance.go",
        "pinned_module.go",
        "recording_store.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/beads/beadstest",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beadmeta",
        "//internal/beads",
    ],
)

go_test(
    name = "beadstest_test",
    srcs = [
        "conformance_skips_test.go",
        "pinned_module_test.go",
        "recording_store_test.go",
        "testenv_import_test.go",
    ],
    embed = [":beadstest"],
    deps = [
        "//internal/beads",
        "//internal/testenv",
    ],
)
