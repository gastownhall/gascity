load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sdnotify",
    srcs = ["sdnotify.go"],
    importpath = "github.com/gastownhall/gascity/internal/sdnotify",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "sdnotify_test",
    srcs = [
        "sdnotify_test.go",
        "testenv_import_test.go",
    ],
    embed = [":sdnotify"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
