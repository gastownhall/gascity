load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "storeref",
    srcs = [
        "bindings.go",
        "class_candidates.go",
        "plan.go",
        "relevance.go",
        "relic_census.go",
        "resolve.go",
        "storeref.go",
        "topology.go",
