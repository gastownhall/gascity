load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "webhookmatch",
    srcs = [
        "doc.go",
        "extract.go",
        "match.go",
        "path.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/webhookmatch",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/orders",
    ],
)

go_test(
    name = "webhookmatch_test",
    srcs = [
        "extract_test.go",
        "match_test.go",
        "path_test.go",
        "testenv_import_test.go",
    ],
    embed = [":webhookmatch"],
    deps = [
        "//internal/config",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
