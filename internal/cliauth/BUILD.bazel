load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cliauth",
    srcs = [
        "client.go",
        "errors.go",
        "store.go",
        "wire.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/cliauth",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/gchome"],
)

go_test(
    name = "cliauth_test",
    srcs = [
        "client_test.go",
        "store_test.go",
        "testenv_import_test.go",
        "wire_test.go",
    ],
    embed = [":cliauth"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
