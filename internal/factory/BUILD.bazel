load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "factory",
    srcs = ["config.go"],
    importpath = "github.com/gastownhall/gascity/internal/factory",
    visibility = ["//:__subpackages__"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "factory_test",
    srcs = [
        "config_test.go",
        "testenv_import_test.go",
    ],
    embed = [":factory"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
