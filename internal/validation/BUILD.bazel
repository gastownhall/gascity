load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "validation",
    srcs = ["skill_collision.go"],
    importpath = "github.com/gastownhall/gascity/internal/validation",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/materialize",
    ],
)

go_test(
    name = "validation_test",
    srcs = [
        "skill_collision_test.go",
        "testenv_import_test.go",
    ],
    embed = [":validation"],
    deps = [
        "//internal/config",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
