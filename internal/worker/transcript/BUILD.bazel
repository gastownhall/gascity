load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "transcript",
    srcs = ["discovery.go"],
    importpath = "github.com/gastownhall/gascity/internal/worker/transcript",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/sessionlog"],
)

go_test(
    name = "transcript_test",
    srcs = [
        "discovery_test.go",
        "testenv_import_test.go",
    ],
    embed = [":transcript"],
    deps = [
        "//internal/sessionlog",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
