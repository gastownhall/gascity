load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "zcode",
    srcs = ["adapter.go"],
    embedsrcs = ["zcode-repl"],
    importpath = "github.com/gastownhall/gascity/internal/worker/adapters/zcode",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "zcode_test",
    srcs = [
        "adapter_test.go",
        "testenv_import_test.go",
    ],
    deps = [
        ":zcode",
        "//internal/pathutil",
        "//internal/sessionlog",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
