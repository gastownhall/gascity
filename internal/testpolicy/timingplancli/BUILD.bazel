load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "timingplancli",
    srcs = ["run.go"],
    importpath = "github.com/gastownhall/gascity/internal/testpolicy/timingplancli",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/testpolicy/timingplan",
        "//internal/testpolicy/timingsummary",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
