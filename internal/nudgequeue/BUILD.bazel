load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nudgequeue",
    srcs = [
        "state.go",
        "store.go",
        "waits.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/nudgequeue",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beads",
        "//internal/citylayout",
        "//internal/clock",
        "//internal/fsys",
    ],
)

go_test(
    name = "nudgequeue_test",
    srcs = [
        "state_test.go",
        "store_test.go",
        "testenv_import_test.go",
        "waits_test.go",
    ],
    embed = [":nudgequeue"],
    deps = [
        "//internal/beads",
        "//internal/beads/beadstest",
        "//internal/clock",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
