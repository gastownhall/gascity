{
  "specs": [
    {
      "name": "pack-config-validation-cli",
      "paths": [
        "cmd/gc/config_pack_validation_test.go"
      ],
      "command": [
        "bazel",
        "test",
        "//cmd/gc:gc_test",
        "--test_filter=^TestConfigValidatePack.*$",
        "--test_sharding_strategy=disabled",
        "--test_env=GO_TEST_WRAP_TESTV=1",
        "--test_output=all",
        "--nocache_test_results"
      ]
    },
    {
      "name": "pack-config-validation-manifests",
      "paths": [
        "internal/config/doctor_discovery_test.go"
      ],
      "command": [
        "bazel",
        "test",
        "//internal/config:config_test",
        "--test_filter=^TestDoctorConfigValidationManifest$",
        "--test_sharding_strategy=disabled",
        "--test_env=GO_TEST_WRAP_TESTV=1",
        "--test_output=all",
        "--nocache_test_results"
      ]
    },
    {
      "name": "pack-config-validation-transport",
      "paths": [
        "internal/doctor/config_validation_test.go",
        "internal/doctor/pack_checks_test.go"
      ],
      "command": [
        "bazel",
        "test",
        "//internal/doctor:doctor_test",
        "--test_filter=^(TestConfigValidation.*|TestPackScriptCheck.*|TestPackScriptConfigValidation.*)$",
        "--test_sharding_strategy=disabled",
        "--test_env=GO_TEST_WRAP_TESTV=1",
        "--test_output=all",
        "--nocache_test_results"
      ]
    }
  ]
}
