load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# gazelle:prefix github.com/gastownhall/gascity
# gazelle:build_tags integration

# internal/config has two libraries sharing one importpath (hand-written bounded
# experiment). All dependents must use the full :config closure.
# gazelle:resolve go github.com/gastownhall/gascity/internal/config //internal/config:config

gazelle(name = "gazelle")

# The integration lane's build (.bazelrc test:integration). Every go_test
# compiles its `//go:build integration` files only there (the build_tags
# directive above lists them in srcs; rules_go filters by the gotags define),
# and selects on this for what only those files need: pinned tools as data,
# the env that hands them over, GC_FAST_UNIT.
config_setting(
    name = "gotags_integration",
    define_values = {"gotags": "integration"},
    visibility = ["//:__subpackages__"],
)

exports_files([
    "MODULE.bazel",
    "go.mod",
    "go.sum",
])

# gofumpt + goimports over every Go file, the formatters `make fmt-check`
# runs through golangci-lint, pinned in MODULE.bazel.
sh_test(
    name = "go_format_test",
    srcs = ["//scripts:check-go-format.sh"],
    args = [
        "$(rootpath @cc_mvdan_gofumpt//:gofumpt)",
        "$(rootpath @org_golang_x_tools//cmd/goimports)",
    ],
    data = [
        "go.mod",
        ":repo_go_srcs",
        ":repo_go_test_srcs",
        "@cc_mvdan_gofumpt//:gofumpt",
        "@org_golang_x_tools//cmd/goimports",
    ],
)

# `goreleaser check` over the release configuration (formerly ci.yml's
# "Release config" job), with the GoReleaser pinned in MODULE.bazel.
sh_test(
    name = "goreleaser_check_test",
    srcs = ["//scripts:check-goreleaser-config.sh"],
    args = [
        "$(rootpath @goreleaser_bin//:goreleaser)",
        "$(rootpath .goreleaser.yml)",
    ],
    data = [
        ".goreleaser.yml",
        "@goreleaser_bin//:goreleaser",
    ],
)

# Unit tests of the CI runner-selection and suite-coverage helpers the
# workflows run (formerly `make test-ci-policy`'s Python half).
py_test(
    name = "ci_runner_policy_test",
    srcs = [
        ".github/workflows/scripts/runner_policy.py",
        ".github/workflows/scripts/test_runner_policy.py",
    ],
    imports = [".github/workflows/scripts"],
    main = ".github/workflows/scripts/test_runner_policy.py",
)

# tools/bazel/ci_analytics_extract.py: the lane/coverage job step that turns
# a BEP file, compact exec log and profile into the redacted ci-analytics
# artifact. testdata/ci_analytics/real/* are genuine Bazel 9.2.0 output
# (regen.sh); poisoned-bep.json proves the redaction leaks nothing.
py_test(
    name = "ci_analytics_extract_test",
    size = "small",
    srcs = [
        "tools/bazel/ci_analytics_extract.py",
        "tools/bazel/ci_analytics_extract_test.py",
    ],
    data = glob(["tools/bazel/testdata/ci_analytics/**"]),
    imports = ["tools/bazel"],
    main = "tools/bazel/ci_analytics_extract_test.py",
)

# tools/bazel/rrc_verify.py: bazel-rrc-verify.yml's nightly check of the
# remote repo contents cache against a cold fetch (ga-vnycm2.26). Its golden
# keys come from Bazel 9.3.0's own writes; .bazelversion must name a release
# it knows the cache GUID of.
py_test(
    name = "rrc_verify_test",
    size = "small",
    srcs = [
        "tools/bazel/rrc_verify.py",
        "tools/bazel/rrc_verify_test.py",
    ],
    data = [".bazelversion"],
    imports = ["tools/bazel"],
    main = "tools/bazel/rrc_verify_test.py",
)

py_test(
    name = "ci_suite_coverage_test",
    srcs = [
        ".github/workflows/scripts/ci_suite_coverage.py",
        ".github/workflows/scripts/test_ci_suite_coverage.py",
    ],
    imports = [".github/workflows/scripts"],
    main = ".github/workflows/scripts/test_ci_suite_coverage.py",
)

