# Repo-root metadata consumed as runfiles by repo-lint tests (//scripts,
# //scripts/cipolicy, //scripts/prwatchdog, //test/qualification, ...).
exports_files([
    ".bazelrc",
    ".bazelversion",
    "MODULE.bazel",
    "Makefile",
    "TESTING.md",
    "go.mod",
    "go.sum",
    "deps.env",
    ".gitignore",
    ".golangci.yml",
    ".goreleaser.yml",
    ".trivyignore.yaml",
])

filegroup(
    name = "repo_meta",
    srcs = [
        ":.gitignore",
        ":.golangci.yml",
        ":.trivyignore.yaml",
        ":Makefile",
        ":TESTING.md",
        ":deps.env",
        ":go.mod",
        ":go.sum",
        ":root_extras",
    ] + glob([
        ".github/**",
        ".githooks/**",
    ]),
    visibility = ["//visibility:public"],
)

# Published command result schemas, read by CLI contract tests.
exports_files(
    glob(["schemas/**"]),
    visibility = ["//visibility:public"],
)

# Committed go.work files at the root (a guard in //cmd/gc:gc_test asserts
# there are none; the glob makes a new one an input so the guard re-runs).
filegroup(
    name = "go_work_files",
    srcs = glob(
        [
            "go.work",
            "go.work.sum",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Pack v2 design docs walked by //internal/config's overlay-directory guard.
filegroup(
    name = "engdocs_packv2_design",
    srcs = glob(["engdocs/design/packv2/**"]),
    visibility = ["//visibility:public"],
)

