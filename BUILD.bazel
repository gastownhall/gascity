# Repo-root metadata consumed as runfiles by repo-lint tests (//scripts,
# //scripts/cipolicy, //scripts/prwatchdog, //test/qualification, ...).
exports_files([
    "Makefile",
    "TESTING.md",
    "go.mod",
    "go.sum",
    "deps.env",
    ".gitignore",
    ".golangci.yml",
    ".trivyignore.yaml",
])

filegroup(
    name = "repo_meta",
    srcs = [
        ":.gitignore",
        ":.golangci.yml",
        ":.trivyignore.yaml",
        ":Makefile",
        ":TESTING.md",
        ":deps.env",
        ":go.mod",
        ":go.sum",
        ":root_extras",
    ] + glob([
        ".github/**",
        ".githooks/**",
    ]),
    visibility = ["//visibility:public"],
)

