load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "swarm_test",
    srcs = [
        "swarm_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//:repo_source_tree",
    ],
    deps = [
        "//internal/bazeltest",
        "//internal/builtinpacks",
        "//internal/config",
        "//internal/fsys",
        "//internal/packman",
        "//internal/testenv",
        "@com_github_burntsushi_toml//:toml",
    ],
)

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "pack_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
