{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["timestamp", "server", "databases", "backups", "orphans", "processes"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "server": {
      "type": "object",
      "required": ["running", "reachable", "external", "pid", "port", "latency_ms"],
      "properties": {
        "running": {
          "type": "boolean"
        },
        "reachable": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "pid": {
          "type": "integer"
        },
        "port": {
          "type": "integer"
        },
        "latency_ms": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "commits", "open_beads"],
        "properties": {
          "name": {
            "type": "string"
          },
          "commits": {
            "type": "integer"
          },
          "open_beads": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "backups": {
      "type": "object",
      "required": ["dolt_measured", "dolt_freshness", "dolt_age_sec", "dolt_stale"],
      "properties": {
        "dolt_measured": {
          "type": "boolean",
          "description": "Whether backup freshness was actually measured. When false, dolt_freshness, dolt_age_sec and dolt_stale carry no information and must not be read as a healthy verdict."
        },
        "dolt_freshness": {
          "type": "string"
        },
        "dolt_age_sec": {
          "type": "integer",
          "description": "Age in seconds of the worst eligible Dolt backup remote, or -1 when that database has never produced a backup file. Carries no information when dolt_measured is false."
        },
        "dolt_stale": {
          "type": ["boolean", "null"],
          "description": "Staleness of the oldest eligible Dolt backup remote, or null when dolt_measured is false. Never false on an unmeasured probe."
        },
        "dolt_databases": {
          "type": "array",
          "description": "Per-database backup freshness. age_sec is -1 for an eligible database that has never produced a backup file; stale is true in that case.",
          "items": {
            "type": "object",
            "required": ["name", "age_sec", "stale"],
            "properties": {
              "name": {
                "type": "string"
              },
              "age_sec": {
                "type": "integer"
              },
              "freshness": {
                "type": "string"
              },
              "stale": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "migration_measured": {
          "type": "boolean"
        },
        "migration_freshness": {
          "type": "string"
        },
        "migration_age_sec": {
          "type": "integer"
        },
        "migration_stale": {
          "type": ["boolean", "null"]
        }
      },
      "additionalProperties": true
    },
    "orphans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "size"],
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "quarantine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["db", "reason", "age_sec"],
        "properties": {
          "db": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "age_sec": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "processes": {
      "type": "object",
      "required": ["zombie_count", "zombie_pids"],
      "properties": {
        "zombie_count": {
          "type": "integer"
        },
        "zombie_pids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
