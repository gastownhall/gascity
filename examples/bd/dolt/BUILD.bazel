load("@rules_go//go:def.bzl", "go_library", "go_test")

# Non-Go pack files are embedded by the parent //examples/bd package via
# go:embed; export them so the parent BUILD can reference them as labels.
exports_files(glob(
    [
        "pack.toml",
        "doctor/**",
        "commands/**",
        "formulas/**",
        "orders/**",
        "agents/**",
        "assets/**",
    ],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "embed_files",
    srcs = glob(
        [
            "pack.toml",
            "doctor/**",
            "commands/**",
            "formulas/**",
            "orders/**",
            "agents/**",
            "assets/**",
        ],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//examples/bd:__pkg__"],
)

