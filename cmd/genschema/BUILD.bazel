load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "genschema_lib",
    srcs = ["main.go"],
    importpath = "github.com/gastownhall/gascity/cmd/genschema",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/docgen",
        "@com_github_invopop_jsonschema//:jsonschema",
    ],
)

go_binary(
    name = "genschema",
    embed = [":genschema_lib"],
    visibility = ["//visibility:public"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
