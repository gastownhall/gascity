load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_test(
    name = "gen-schema-baseline_test",
    srcs = [
        "main_test.go",
        "testenv_import_test.go",
    ],
    embed = [":gen-schema-baseline_lib"],
    deps = [
        "//internal/schemacontract",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

go_library(
    name = "gen-schema-baseline_lib",
    srcs = ["main.go"],
    importpath = "github.com/gastownhall/gascity/cmd/gen-schema-baseline",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "gen-schema-baseline",
    embed = [":gen-schema-baseline_lib"],
    visibility = ["//visibility:public"],
)
