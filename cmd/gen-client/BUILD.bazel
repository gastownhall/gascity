load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gen-client_lib",
    srcs = ["main.go"],
    importpath = "github.com/gastownhall/gascity/cmd/gen-client",
    visibility = ["//visibility:private"],
    deps = ["//internal/api"],
)

go_binary(
    name = "gen-client",
    embed = [":gen-client_lib"],
    visibility = ["//visibility:public"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
