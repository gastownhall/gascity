load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gen-command-census_lib",
    srcs = ["main.go"],
    importpath = "github.com/gastownhall/gascity/cmd/gen-command-census",
    visibility = ["//visibility:private"],
    deps = ["//internal/commandcensus"],
)

go_binary(
    name = "gen-command-census",
    embed = [":gen-command-census_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "gen-command-census_test",
    srcs = [
        "main_test.go",
        "testenv_import_test.go",
    ],
    embed = [":gen-command-census_lib"],
    deps = [
        "//internal/commandcensus",
        "//internal/testenv",
    ],
)
