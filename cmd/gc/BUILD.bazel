# gc linked with test hooks (internal/clock.testHooks): the only binary in
# which GC_TEST_BACKSTOP_SPEEDUP divides the controller's backstop cadences.
# testonly, manual, and visible only to the acceptance rows that use it;
# scripts/cmd_gc_testhooks_test.go keeps the stamp out of every other link
# and out of the release config.
# keep
go_binary(
    name = "gc_testhooks",
    testonly = True,
    embed = [":gc_lib"],
    tags = ["manual"],
    visibility = ["//test/acceptance:__pkg__"],
    x_defs = {"github.com/gastownhall/gascity/internal/clock.testHooks": "enabled"},
)

# Two gc links that differ only in their stamped build commit (what the
# release build's -ldflags "-X main.commit=..." sets), for the supervisor
# binary-drift tests in //test/integration (start_drift_test.go). Those tests
# used to `go build ./cmd/gc` inside the test action, which needs go.sum and a
# module download that remote workers cannot do (and the fork pool has no
# network). Keep the commits equal to driftHappyOldCommit /
# driftHappyNewCommit.
# keep
go_binary(
    name = "gc_drift_old",
    testonly = True,
    embed = [":gc_lib"],
    # Built only as data of //test/integration:integration_test, never by //...
    tags = ["manual"],
    visibility = ["//test/integration:__pkg__"],
    x_defs = {"main.commit": "deadbeefcafe1111"},
)

# keep
go_binary(
    name = "gc_drift_new",
    testonly = True,
    embed = [":gc_lib"],
    # Built only as data of //test/integration:integration_test, never by //...
    tags = ["manual"],
    visibility = ["//test/integration:__pkg__"],
    x_defs = {"main.commit": "facefeed02222222"},
)

