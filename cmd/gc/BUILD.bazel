load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel/rules:go_variant_test.bzl", "go_variant_test")

# productmetrics_testhook (beside the root's integration): the tagged files
# are listed in srcs, and rules_go drops them again in every configuration
# without the tag, so gc_productmetrics_testhook_test can build gc_test with
# -tags productmetrics_testhook.
# gazelle:build_tags integration,productmetrics_testhook

# gc_test's process-backed tests that run for 20 s or more in the integration
# build (GC_FAST_UNIT=0; seconds measured 2026-10-08 under bazel on rbe-west,
# --config=ci --config=integration --config=fresh, 12 shards). rules_go
# assigns a go_test's tests to shards round-robin in source order, and
# gc_test's ~12,000 tests shift on nearly every cmd/gc PR, so no shard_count
# keeps these apart for long: two of them in one shard is how
# integration-packages' gc_test shards #1 and #7 ran 110-128 s against ~40 s
# for the rest (spec-speed S5). In the integration build gc_test skips them
# and each runs alone in a target of its own (same binary, no extra compile),
# which //test:integration_packages runs through :gc_integration_solo_tests.
# The unit build keeps them in gc_test, where all but
# TestPackCommandCobraHelpAndUnknownParity skip under GC_FAST_UNIT.
# scripts/cmd_gc_shards_test.go reads this table.
INTEGRATION_SOLO_TESTS = {
    "gc_bd_runtime_custom_types_heal_test": "TestEnsureBdRuntimeCustomTypesHealsUpgradedNativeStore",  # 36 s
    "gc_managed_beads_native_cli_test": "TestManagedBeadsNativeCLICompatibility",  # 32 s
    "gc_managed_bd_rig_hard_kill_test": "TestManagedBdRigProviderStoreRecoversAfterHardKillPortRebind",  # 26 s
    "gc_pack_command_cobra_parity_test": "TestPackCommandCobraHelpAndUnknownParity",  # 22 s
    "gc_phase2_worker_core_transport_test": "TestPhase2WorkerCoreRealTransportProof",  # 58 s
    "gc_provider_owned_real_init_test": "TestGcBeadsBdProviderOwnedRealInitIgnoresAncestorBeadsWorkspace",  # 29 s
}

