# The tagged product-metrics contracts (`make test-productmetrics-testhook`):
# gc_test built with -tags productmetrics_testhook, which swaps in the test
# hooks, running only the tests that need them.
go_variant_test(
    name = "gc_productmetrics_testhook_test",
    args = ["-test.run=^(TestProductMetricsTaggedBinaryProcessContracts|TestProductMetricsTesthookEndpointAcceptsOnlyLoopbackHTTPS|TestProductMetricsTaggedRunnerReadsInjectionOnlyAtInvocation|TestProductMetricsTesthookCAReadIsBounded|TestProductMetricsTaggedProcessFixtureIsEnabled|TestProductMetricsTestOnlyCensusEscapeIsNarrow)$$"],
    gotags = ["productmetrics_testhook"],
    test = ":gc_test",
)

# INTEGRATION_SOLO_TESTS, each alone, in gc_test's integration build.
# Manual: the unit lane's //... does not run them (gc_test runs them there);
# tools/bazel/integration_suite.py lists :gc_integration_solo_tests in
# //test:integration_packages.
[go_variant_test(
    name = name,
    size = "large",
    args = ["-test.run=^%s$$" % test],
    tags = ["manual"],
    test = ":gc_test",
) for name, test in INTEGRATION_SOLO_TESTS.items()]

test_suite(
    name = "gc_integration_solo_tests",
    tags = ["manual"],
    tests = [":" + name for name in INTEGRATION_SOLO_TESTS],
)

