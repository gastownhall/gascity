load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gc-write-mint_lib",
    srcs = ["main.go"],
    importpath = "github.com/gastownhall/gascity/cmd/gc-write-mint",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/citywriteauth",
        "//internal/clientgrant",
    ],
)

go_binary(
    name = "gc-write-mint",
    embed = [":gc-write-mint_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "gc-write-mint_test",
    srcs = [
        "main_test.go",
        "testenv_import_test.go",
    ],
    embed = [":gc-write-mint_lib"],
    deps = [
        "//internal/citywriteauth",
        "//internal/clientgrant",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
