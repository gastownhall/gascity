load("@rules_go//go:def.bzl", "go_test", "nogo")
load(":analyzers.bzl", "NOGO_ANALYZERS")

# gazelle:prefix github.com/gastownhall/gascity/tools/nogo

# nogo: lint and vet as part of every Go compile. MODULE.bazel registers this
# target with go_sdk.nogo, so `bazel build //...` (locally or on RBE) fails on
# any finding. Replaces `go vet` and golangci-lint's linters; formatting stays
# with `make fmt-check`.
nogo(
    name = "nogo",
    config = "config.json",
    visibility = ["//visibility:public"],
    deps = NOGO_ANALYZERS,
)

exports_files([
    "analyzers.bzl",
    "config.json",
    "go.mod",
])

go_test(
    name = "nogo_test",
    srcs = [
        "analyzers_test.go",
        "modules_test.go",
    ],
    data = [
        "analyzers.bzl",
        "config.json",
        "go.mod",
        "//:go.mod",
    ],
    deps = [
        "//tools/nogo/analyzers/errorlint",
        "//tools/nogo/analyzers/gocritic",
        "//tools/nogo/analyzers/misspell",
        "//tools/nogo/analyzers/revive",
        "//tools/nogo/analyzers/runtimelease",
        "//tools/nogo/analyzers/testrelax",
        "//tools/nogo/analyzers/unconvert",
        "//tools/nogo/analyzers/unparam",
        "//tools/nogo/analyzers/unused",
        "//tools/nogo/analyzers/v2purity",
        "@co_honnef_go_tools//analysis/lint",
        "@co_honnef_go_tools//quickfix",
        "@co_honnef_go_tools//simple",
        "@co_honnef_go_tools//staticcheck",
        "@co_honnef_go_tools//stylecheck",
        "@com_github_gordonklaus_ineffassign//pkg/ineffassign",
        "@com_github_kisielk_errcheck//errcheck",
        "@org_golang_x_mod//modfile",
        "@org_golang_x_mod//semver",
        "@org_golang_x_tools//go/analysis",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
