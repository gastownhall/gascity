# rbe_worker: the execution platform of every build (.bazelrc selects it
# unconditionally with --extra_execution_platforms, so every action and test
# executes on it and local, fork-cache and remote runs hash alike).
#
# Test actions exec host tools through the client's PATH, and the host runs
# the hermetic C toolchain and loads the shared libraries of every binary it
# links (libstdc++, ICU), so the worker host is an input to every
# cached result. Its exec_properties enter each action's key: worker-env is
# the sha256 of tools/rbe/worker-env.txt, the toolchain manifest of the
# pinned worker host (arch, OS release, Go, dolt, and the upstream releases
# of the libraries and tools actions reach; not the image's patch revisions).
# The pool workers (gastownhall/rbe-worker's worker/blacksmith-worker.sh, at
# .github/actions/rbe-worker/pin) advertise the sha256 of the manifest they
# measure on their own host (worker/worker-env) and rbe-west's schedulers
# match worker-env exactly, so these actions run only on the pinned toolchain, and
# a toolchain change takes a new manifest and pin here, which is a new key
# for every action. gastownhall/beads carries a byte-identical copy of the
# manifest and the same pin. scripts/rbe_worker_env_test.go keeps the pin
# and the manifest in step.
platform(
    name = "rbe_worker",
    exec_properties = {
        "worker-env": "sha256:0c6c05c2196c246dba37e106a3d028e2f47f2e3d7eae0e41c2fe2bd9b2e4f6f0",
    },
    parents = ["@bazel_tools//tools:host_platform"],
    visibility = ["//visibility:public"],
)

exports_files(["BUILD.bazel"])
