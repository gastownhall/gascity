# Test files in internal/runtime/tmux that compile only with -tags integration
# (linux/amd64) and declare at least one test: the integration-only lane.
# One _test.go basename per line, strictly ascending in byte order.
# A new //go:build integration test file with tests needs one line here, in
# sorted position; scripts/runtime_tmux_lane_test.go fails until it is added.
