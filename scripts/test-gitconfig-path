#!/bin/sh
# test-gitconfig-path — print the path of a seeded, writable global gitconfig
# for the test environment. Shared by the Makefile TEST_ENV and every nested
# env -i test runner so the four call sites cannot drift.
#
# The path is stable per user and per repo so concurrent shards converge on
# one file, and creation is atomic (temp + mv) so racing shards never observe
# a partial seed. The seed is load-bearing twice: ensure_beads_role's read
# short-circuits so the code under test never needs the global write path,
# and the identity fields keep ensure_dolt_identity on its no-fallback path.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
repo_hash=$(printf '%s' "$repo_root" | cksum | awk '{print $1}')
temp_root=${TMPDIR:-/var/tmp}
path="$temp_root/gc-test-gitconfig-$(id -u)-${repo_hash}"

if [ ! -f "$path" ]; then
  # Bazel's sandbox can make /var/tmp look writable to access(2) while denying
  # the actual create. Probe with the operation we need, then fall back only to
  # Bazel's already-declared writable short test root.
  if ! tmp=$(mktemp "${path}.XXXXXX" 2>/dev/null); then
    temp_root=/tmp/bt
    path="$temp_root/gc-test-gitconfig-$(id -u)-${repo_hash}"
    if [ -f "$path" ]; then
      printf '%s\n' "$path"
      exit 0
    fi
    tmp=$(mktemp "${path}.XXXXXX")
  fi
  cat > "$tmp" <<'EOF'
[user]
	name = gc-test
	email = gc-test@test.local
[beads]
	role = maintainer
[safe]
	directory = *
EOF
  mv -f "$tmp" "$path"
fi
printf '%s\n' "$path"
