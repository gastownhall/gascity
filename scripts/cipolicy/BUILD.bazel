load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cipolicy",
    srcs = ["policy.go"],
    importpath = "github.com/gastownhall/gascity/scripts/cipolicy",
    visibility = ["//visibility:public"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_test(
    name = "cipolicy_test",
    srcs = [
        "policy_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//:repo_meta",
    ],
    embed = [":cipolicy"],
    deps = [
        "//internal/testenv",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
