"""Minimal Bzlmod entry point for the incremental Go build pilot."""

module(
    name = "gascity",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")

# nogo honors //nolint directives through ast.CommentMap ranges, which differ
# from golangci-lint's (a comment trailing `func f(...) {` attaches to the
# body's first statement). This tree's directives were written against
# golangci-lint, so the patch adds golangci-lint's ranges as well.
single_version_override(
    module_name = "rules_go",
    patch_strip = 1,
    patches = ["//third_party/patches:rules_go_nogo_golangci_nolint.patch"],
    version = "0.63.0",
)
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "toolchains_llvm", version = "1.11.0")

# Loaded by @llvm_dist_linux_x86_64's BUILD file (toolchains_llvm's template).
bazel_dep(name = "rules_cc", version = "0.2.17")

# sh_test / py_test for the repo's shell guards and CI-policy unit tests
# (Bazel 9 has no native shell or Python rules). Same versions the rest of
# the module graph already resolves.
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_python", version = "1.7.0")

# The dashboard SPA (internal/api/dashboardspa/web) builds and tests under
# rules_js: a pinned Node.js toolchain, every npm package fetched by Bazel
# from the committed pnpm-lock.yaml (integrity-pinned, so remote workers
# need neither npm nor network), and tsc/vite/vitest run as Bazel actions.
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "bazel_lib", version = "3.7.2")

# Hermetic C/C++ toolchain. rules_go builds the Go stdlib and every cgo
# package (Dolt's go-icu-regex, gozstd, gopsutil, ...) with the registered C
# toolchain, and every Go compile depends on the stdlib, so a host-detected
# toolchain (local_config_cc: CC=/usr/bin/gcc, -fuse-ld=lld only where lld is
# installed, gcc-version-specific generated inputs) keys every Go action to
# the machine that ran it. Instead: LLVM pinned by sha256, plus a sysroot of
# pinned Ubuntu 24.04 packages (the RBE workers' release, so binaries load
# the same glibc, libstdc++ and ICU sonames there), byte-identical on every
# Linux x86_64 host. .bazelrc turns host detection off so nothing falls back
# to the host compiler; scripts/bazel_hermetic_cc_test.go guards both.
deb_sysroot = use_repo_rule("//third_party/cc_toolchain:deb_sysroot.bzl", "deb_sysroot")

deb_sysroot(
    name = "cc_sysroot_noble_amd64",
    mirrors = [
        "https://snapshot.ubuntu.com/ubuntu/20261001T000000Z/",
        "https://archive.ubuntu.com/ubuntu/",
    ],
    packages = {
        "pool/main/g/gcc-13/libgcc-13-dev_13.3.0-6ubuntu2~24.04.1_amd64.deb": "cd689db2691edaa10f37329307292796bb599e722e0505c79e14caaa1fe9a93a",
        "pool/main/g/gcc-13/libstdc++-13-dev_13.3.0-6ubuntu2~24.04.1_amd64.deb": "ee5633e863e19c3381ed97842ce35ed32ede96a3d1ae4e94c051d3036fe21347",
        "pool/main/g/gcc-14/libgcc-s1_14.2.0-4ubuntu2~24.04.1_amd64.deb": "aa7fadbe33b78bcf99885318040601c550c208929565b179891d9a3cc2aa68cd",
        "pool/main/g/gcc-14/libstdc++6_14.2.0-4ubuntu2~24.04.1_amd64.deb": "a51f8de7829211db961a31f02158058ad1a95f92ac6d0a5dff6350e2821c54c0",
        "pool/main/g/glibc/libc6-dev_2.39-0ubuntu8.9_amd64.deb": "e13d5fcc1b2a86f75bca8e0026a8e39f24fe97ca86e92be79991f8697eb1306f",
        "pool/main/g/glibc/libc6_2.39-0ubuntu8.9_amd64.deb": "ff5557d99b51f761c4b7c92368b9cc45565eda17df9bf9eb4b134d09825008be",
        "pool/main/i/icu/libicu-dev_74.2-1ubuntu3.1_amd64.deb": "612b98f4fcfc6ebc57a1b21c2695174694db5a0b7ff760b5d41032076c792398",
        "pool/main/i/icu/libicu74_74.2-1ubuntu3.1_amd64.deb": "c9a70989678660eed9a1e904c74fa043da8bec8e2036856fc16e31ced79b04f8",
        "pool/main/l/linux/linux-libc-dev_6.8.0-146.146_amd64.deb": "1a7bb04132d01cd14bea3d615e5861096ca1f70c4659902eb14b36c21993cadc",
    },
