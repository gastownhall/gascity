# The Go formatters `make fmt-check` runs through golangci-lint (gofumpt and
# goimports), as standalone binaries for //:go_format_test. gofumpt is pinned
# to the version golangci-lint (GOLANGCI_LINT_VERSION in the Makefile)
# bundles; goimports comes from the golang.org/x/tools gc's go.mod already
# pins. go-cmp is the one gofumpt requirement gc's go.mod lacks.
go_deps.module(
    path = "mvdan.cc/gofumpt",
    sum = "h1:zsEMWL8SVKGHNztrx6uZrXdp7AX8r421Vvp23sz7ik4=",
    version = "v0.9.2",
)
go_deps.module(
    indirect = True,
    path = "github.com/google/go-cmp",
    sum = "h1:wk8382ETsv4JYUZwIsn6YpYiWiBsYLSJiTsyBybVuN8=",
    version = "v0.7.0",
)

# nogo analyzers (//tools/nogo) that type-check through importer.Default()
# need `go list -export`, which nogo actions do not have; the patches read
# the standard library's export data from rules_go's stdlib GOROOT instead.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:go_ruleguard_bazel_gcimporter.patch"],
    path = "github.com/quasilyte/go-ruleguard",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:revive_bazel_gcimporter.patch"],
    path = "github.com/mgechev/revive",
)

# nogo does not analyze the standard library, so ctrlflow has no noReturn
# facts for t.Fatal, log.Fatal, os.Exit, ...; without them staticcheck's
# SA5011 reports every nil check followed by t.Fatal. The patch makes
# ctrlflow know those standard-library functions intrinsically.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:x_tools_ctrlflow_stdlib_noreturn.patch"],
    path = "golang.org/x/tools",
)
