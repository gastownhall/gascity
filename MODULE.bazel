"""Minimal Bzlmod entry point for the incremental Go build pilot."""

module(
    name = "gascity",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "toolchains_llvm", version = "1.11.0")

# Loaded by @llvm_dist_linux_x86_64's BUILD file (toolchains_llvm's template).
bazel_dep(name = "rules_cc", version = "0.2.17")

# Hermetic C/C++ toolchain. rules_go builds the Go stdlib and every cgo
# package (Dolt's go-icu-regex, gozstd, gopsutil, ...) with the registered C
# toolchain, and every Go compile depends on the stdlib, so a host-detected
# toolchain (local_config_cc: CC=/usr/bin/gcc, -fuse-ld=lld only where lld is
# installed, gcc-version-specific generated inputs) keys every Go action to
# the machine that ran it. Instead: LLVM pinned by sha256, plus a sysroot of
# pinned Ubuntu 24.04 packages (the RBE workers' release, so binaries load
# the same glibc, libstdc++ and ICU sonames there), byte-identical on every
# Linux x86_64 host. .bazelrc turns host detection off so nothing falls back
# to the host compiler; scripts/bazel_hermetic_cc_test.go guards both.
deb_sysroot = use_repo_rule("//third_party/cc_toolchain:deb_sysroot.bzl", "deb_sysroot")

deb_sysroot(
    name = "cc_sysroot_noble_amd64",
    mirrors = [
        "https://snapshot.ubuntu.com/ubuntu/20261001T000000Z/",
        "https://archive.ubuntu.com/ubuntu/",
    ],
    packages = {
        "pool/main/g/gcc-13/libgcc-13-dev_13.3.0-6ubuntu2~24.04.1_amd64.deb": "cd689db2691edaa10f37329307292796bb599e722e0505c79e14caaa1fe9a93a",
        "pool/main/g/gcc-13/libstdc++-13-dev_13.3.0-6ubuntu2~24.04.1_amd64.deb": "ee5633e863e19c3381ed97842ce35ed32ede96a3d1ae4e94c051d3036fe21347",
        "pool/main/g/gcc-14/libgcc-s1_14.2.0-4ubuntu2~24.04.1_amd64.deb": "aa7fadbe33b78bcf99885318040601c550c208929565b179891d9a3cc2aa68cd",
        "pool/main/g/gcc-14/libstdc++6_14.2.0-4ubuntu2~24.04.1_amd64.deb": "a51f8de7829211db961a31f02158058ad1a95f92ac6d0a5dff6350e2821c54c0",
        "pool/main/g/glibc/libc6-dev_2.39-0ubuntu8.9_amd64.deb": "e13d5fcc1b2a86f75bca8e0026a8e39f24fe97ca86e92be79991f8697eb1306f",
        "pool/main/g/glibc/libc6_2.39-0ubuntu8.9_amd64.deb": "ff5557d99b51f761c4b7c92368b9cc45565eda17df9bf9eb4b134d09825008be",
        "pool/main/i/icu/libicu-dev_74.2-1ubuntu3.1_amd64.deb": "612b98f4fcfc6ebc57a1b21c2695174694db5a0b7ff760b5d41032076c792398",
        "pool/main/i/icu/libicu74_74.2-1ubuntu3.1_amd64.deb": "c9a70989678660eed9a1e904c74fa043da8bec8e2036856fc16e31ced79b04f8",
        "pool/main/l/linux/linux-libc-dev_6.8.0-146.146_amd64.deb": "1a7bb04132d01cd14bea3d615e5861096ca1f70c4659902eb14b36c21993cadc",
    },
    remove = [
        "etc",
        "usr/bin",
        "usr/sbin",
        "usr/share",
        "usr/lib/x86_64-linux-gnu/gconv",
        "usr/lib/x86_64-linux-gnu/libicu*.a",
        "usr/lib/x86_64-linux-gnu/libicuio.*",
        "usr/lib/x86_64-linux-gnu/libicutest.*",
        "usr/lib/x86_64-linux-gnu/libicutu.*",
        "usr/lib/gcc/x86_64-linux-gnu/13/crtoffload*",
        "usr/lib/gcc/x86_64-linux-gnu/13/lib*san*",
        "usr/lib/gcc/x86_64-linux-gnu/13/libatomic*",
        "usr/lib/gcc/x86_64-linux-gnu/13/libbacktrace*",
        "usr/lib/gcc/x86_64-linux-gnu/13/libgcov*",
        "usr/lib/gcc/x86_64-linux-gnu/13/libgomp*",
        "usr/lib/gcc/x86_64-linux-gnu/13/libitm*",
        "usr/lib/gcc/x86_64-linux-gnu/13/libquadmath*",
        "usr/lib/gcc/x86_64-linux-gnu/13/libstdc++*.a",
    ],
)

LLVM_VERSION = "22.1.8"

llvm_dist = use_repo_rule("//third_party/cc_toolchain:llvm_dist.bzl", "llvm_dist")

llvm_dist(
    name = "llvm_dist_linux_x86_64",
    llvm_version = LLVM_VERSION,
    members = [
        "bin/clang",
        "bin/clang++",
        "bin/clang-22",
        "bin/clang-cpp",
        "bin/ld.lld",
        "bin/ld64.lld",
        "bin/lld",
        "bin/llvm-ar",
        "bin/llvm-as",
        "bin/llvm-cov",
        "bin/llvm-install-name-tool",
        "bin/llvm-nm",
        "bin/llvm-objcopy",
        "bin/llvm-objdump",
        "bin/llvm-profdata",
        "bin/llvm-ranlib",
        "bin/llvm-readelf",
        "bin/llvm-readobj",
        "bin/llvm-strip",
        "bin/llvm-symbolizer",
        "bin/wasm-ld",
        "include/c++",
        "include/x86_64-unknown-linux-gnu",
        "lib/clang/22/include",
        "lib/clang/22/lib/x86_64-unknown-linux-gnu/clang_rt.crtbegin.o",
        "lib/clang/22/lib/x86_64-unknown-linux-gnu/clang_rt.crtend.o",
        "lib/clang/22/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a",
        # `bazel coverage` links cgo binaries with -fprofile-instr-generate,
        # which pulls in compiler-rt's profile runtime (~170KB).
        "lib/clang/22/lib/x86_64-unknown-linux-gnu/libclang_rt.profile.a",
    ],
    sha256 = "df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384",
    strip_prefix = "LLVM-22.1.8-Linux-X64",
    stub_tools = [
        "clang-format",
        "clang-tidy",
        "clangd",
        "llvm-dwp",
    ],
    urls = ["https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.8/LLVM-22.1.8-Linux-X64.tar.xz"],
)

# Every other host (macOS arm64, Linux arm64) runs toolchains_llvm's stock
# LLVM_VERSION release for its platform, pinned by sha256 in toolchains_llvm's
# distribution table and fetched only there. Once any toolchain_root is set,
# toolchains_llvm creates no stock distribution of its own and fails every
# build on a host no root covers. Not hermetic there: no sysroot, so cgo
# uses the host's headers and libraries (ICU included), as before.
llvm_host_dist = use_repo_rule("@toolchains_llvm//toolchain:rules.bzl", "llvm")

llvm_host_dist(
    name = "llvm_dist_host",
    llvm_version = LLVM_VERSION,
    # The bare rule reads the per-host dict; llvm_toolchain's macro would
    # fill it in from llvm_version.
    llvm_versions = {"": LLVM_VERSION},
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = LLVM_VERSION,
    # The sysroot's libstdc++, linked dynamically as host-gcc builds did:
    # ICU's libraries are built against it.
    stdlib = {"linux-x86_64": "dynamic-stdc++"},
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_dist_linux_x86_64//:BUILD.bazel",
    targets = ["linux-x86_64"],
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_dist_host//:BUILD.bazel",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@cc_sysroot_noble_amd64//:sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

# The pilot uses a pinned SDK so local and CI actions compile with the same
# toolchain. Update this in lockstep with the `go` directive in go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.6",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# External repos that ship WORKSPACE-era BUILD files referencing apparent
# repo names (@rules_go, @protobuf, @npm, @rules_pkg) which are not visible
# from go_deps extension repositories under Bzlmod. Patches swap them for
# plain go_library rules over the checked-in generated sources.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:eventsapi_schema_build.patch"],
    path = "github.com/dolthub/eventsapi_schema",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:flatbuffers_v23_importpath.patch"],
    path = "github.com/dolthub/flatbuffers/v23",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:dolt_go_serial.patch"],
    path = "github.com/dolthub/dolt/go",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:beads_migrations.patch"],
    path = "github.com/steveyegge/beads",
)

# protoc-gen-validate's validate package regenerates the checked-in
# validate.pb.go with go_proto_library, both in gazelle's default proto mode
# and in the module's own validate/BUILD, which pulls the C++ protoc and
# abseil (~1600 targets) into the analysis of everything linking the dolt
# driver (grpc xds -> envoy -> validate). Disable gazelle's proto rules and
# patch validate/BUILD to build the checked-in source instead.
go_deps.gazelle_override(
    directives = ["gazelle:proto disable"],
    path = "github.com/envoyproxy/protoc-gen-validate",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:protoc_gen_validate_build.patch"],
    path = "github.com/envoyproxy/protoc-gen-validate",
)
use_repo(go_deps, "com_github_burntsushi_toml", "com_github_cenkalti_backoff_v4", "com_github_danielgtaylor_huma_v2", "com_github_fsnotify_fsnotify", "com_github_gastownhall_gascity_packs", "com_github_go_jose_go_jose_v4", "com_github_go_sql_driver_mysql", "com_github_golang_jwt_jwt_v5", "com_github_google_shlex", "com_github_google_uuid", "com_github_gorilla_websocket", "com_github_invopop_jsonschema", "com_github_masterminds_semver_v3", "com_github_oapi_codegen_runtime", "com_github_pb33f_libopenapi", "com_github_pb33f_libopenapi_validator", "com_github_rogpeppe_go_internal", "com_github_santhosh_tekuri_jsonschema_v6", "com_github_shirou_gopsutil_v4", "com_github_spf13_cobra", "com_github_spf13_pflag", "com_github_steveyegge_beads", "com_github_stretchr_testify", "in_gopkg_yaml_v3", "io_k8s_api", "io_k8s_apimachinery", "io_k8s_client_go", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlplog_otlploghttp", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetrichttp", "io_opentelemetry_go_otel_log", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_log", "io_opentelemetry_go_otel_sdk_metric", "net_pgregory_rapid", "org_golang_x_mod", "org_golang_x_sync", "org_golang_x_sys", "org_golang_x_term", "org_modernc_sqlite")

# Pinned prebuilt test-only binaries for hermetic integration/acceptance tests.
# Same artifacts the go-test CI installs via .github/scripts/install-bd-archive.sh
# and install-dolt-archive.sh; shas are release-pinned.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "bd_bin_v1_3_1",
    urls = ["https://github.com/gastownhall/beads/releases/download/v1.3.1/beads_1.3.1_linux_amd64.tar.gz"],
    sha256 = "3219443a9734b89b93fb16ee8d65844759fa1b3cd3cf139c606b7353cfb0715c",
    build_file_content = """
exports_files(["bd"])
""",
)

http_archive(
    name = "dolt_bin_v2_2_0",
    urls = ["https://github.com/dolthub/dolt/releases/download/v2.2.0/dolt-linux-amd64.tar.gz"],
    sha256 = "1f7ad8c2622995789420a3fb0f2d16b4aa7430000a825dd91d5938f36480cbf6",
    build_file_content = """
exports_files(["dolt-linux-amd64/bin/dolt"])
""",
)
