LLVM_VERSION = "22.1.8"

llvm_dist = use_repo_rule("//third_party/cc_toolchain:llvm_dist.bzl", "llvm_dist")

llvm_dist(
    name = "llvm_dist_linux_x86_64",
    llvm_version = LLVM_VERSION,
    members = [
        "bin/clang",
        "bin/clang++",
        "bin/clang-22",
        "bin/clang-cpp",
        "bin/ld.lld",
        "bin/ld64.lld",
        "bin/lld",
        "bin/llvm-ar",
