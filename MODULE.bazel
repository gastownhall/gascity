# Every other host (macOS arm64, Linux arm64) runs toolchains_llvm's stock
# LLVM_VERSION release for its platform, pinned by sha256 in toolchains_llvm's
# distribution table and fetched only there. Once any toolchain_root is set,
# toolchains_llvm creates no stock distribution of its own and fails every
# build on a host no root covers. Not hermetic there: no sysroot, so cgo
# uses the host's headers and libraries (ICU included), as before.
llvm_host_dist = use_repo_rule("@toolchains_llvm//toolchain:rules.bzl", "llvm")

llvm_host_dist(
    name = "llvm_dist_host",
    llvm_version = LLVM_VERSION,
    # The bare rule reads the per-host dict; llvm_toolchain's macro would
    # fill it in from llvm_version.
    llvm_versions = {"": LLVM_VERSION},
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = LLVM_VERSION,
    # The sysroot's libstdc++, linked dynamically as host-gcc builds did:
    # ICU's libraries are built against it.
    stdlib = {"linux-x86_64": "dynamic-stdc++"},
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_dist_linux_x86_64//:BUILD.bazel",
    targets = ["linux-x86_64"],
)
llvm.toolchain_root(
    name = "llvm_toolchain",
    label = "@llvm_dist_host//:BUILD.bazel",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@cc_sysroot_noble_amd64//:sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

# The pilot uses a pinned SDK so local and CI actions compile with the same
# toolchain. Update this in lockstep with the `go` directive in go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.6",
)
use_repo(go_sdk, "go_sdk")

# nogo: //tools/nogo's analyzers (go vet's suite plus golangci-lint's
# configured linters) run beside every first-party Go compile, so lint and
# vet findings fail `bazel build`/`bazel test` wherever they execute (RBE
# included). External repos only feed analyzer facts; they are not validated.
go_sdk.nogo(
    includes = ["//:__subpackages__"],
    nogo = "//tools/nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:gazelle.go.work")

# External repos that ship WORKSPACE-era BUILD files referencing apparent
# repo names (@rules_go, @protobuf, @npm, @rules_pkg) which are not visible
# from go_deps extension repositories under Bzlmod. Patches swap them for
# plain go_library rules over the checked-in generated sources.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:eventsapi_schema_build.patch"],
    path = "github.com/dolthub/eventsapi_schema",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:flatbuffers_v23_importpath.patch"],
    path = "github.com/dolthub/flatbuffers/v23",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:dolt_go_serial.patch"],
    path = "github.com/dolthub/dolt/go",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:beads_migrations.patch"],
    path = "github.com/steveyegge/beads",
)

# protoc-gen-validate's validate package regenerates the checked-in
# validate.pb.go with go_proto_library, both in gazelle's default proto mode
# and in the module's own validate/BUILD, which pulls the C++ protoc and
# abseil (~1600 targets) into the analysis of everything linking the dolt
# driver (grpc xds -> envoy -> validate). Disable gazelle's proto rules and
# patch validate/BUILD to build the checked-in source instead.
go_deps.gazelle_override(
    directives = ["gazelle:proto disable"],
    path = "github.com/envoyproxy/protoc-gen-validate",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:protoc_gen_validate_build.patch"],
    path = "github.com/envoyproxy/protoc-gen-validate",
)

