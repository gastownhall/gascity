        # `bazel coverage` links cgo binaries with -fprofile-instr-generate,
        # which pulls in compiler-rt's profile runtime (~170KB).
        "lib/clang/22/lib/x86_64-unknown-linux-gnu/libclang_rt.profile.a",
    ],
    # LLVM-22.1.8-Linux-X64.tar.xz (sha256 df0e1ecf...0006384), sliced to the
    # members above by tools/cc_toolchain/repack_llvm.sh: 149 MB instead of
    # 1.94 GB, and no single-threaded xz pass on every cold runner.
    sha256 = "de6147773999137b70ef3d7bd8ecb1e5b91f2a161d02fd09aec591b84516bec5",
    sliced = True,
    stub_tools = [
        "clang-format",
        "clang-tidy",
        "clangd",
        "llvm-dwp",
    ],
    # Hosting is decision D3 (a release asset of a gastownhall repository).
