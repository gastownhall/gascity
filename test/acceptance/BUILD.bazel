        "@com_github_go_sql_driver_mysql//:mysql",
        "@net_pgregory_rapid//:rapid",
    ],
)

# The shard placement guard (scripts/acceptance_shards_test.go) reads this
# file's srcs and shard_count.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//scripts:__pkg__"],
)

# The external bd CLI contract (`make test-bd-cli-contract` and
# `make test-bd-cli-contract-home-isolation`, one run): acceptance_test built
# with -tags acceptance_bd_contract alone, against a pinned bd per cell.
# GC_ACCEPTANCE_BD_BIN names the cell's bd and nothing else is used: a set
# override that does not resolve fails the test (helpers.RequireBD).
#
#   prev     deps.env BD_PREV_VERSION, the minimum-supported release
#   current  deps.env BD_CURRENT_REF; that commit is the v1.3.1 tag, whose
#            release binary is @bd_bin_v1_3_1 (scripts/bd_contract_pins_test.go
#            pins the correspondence)
BD_CLI_CONTRACT_RUN = "-test.run=^(TestBdBasicCRUD|TestBdDependencies|TestBdDestructive|TestBdWorkflow|TestRunBDIsolatesHOMEFromSharedServerConfig)$$"

go_variant_test(
    name = "bd_cli_contract_prev_test",
    size = "large",
    args = [BD_CLI_CONTRACT_RUN],
    data = ["@bd_bin_v1_0_4//:bd"],
    env = {
        "GC_ACCEPTANCE_BD_BIN": "$(rootpath @bd_bin_v1_0_4//:bd)",
        "GC_TEST_TOOL_PATHS": "$(rootpath @bd_bin_v1_0_4//:bd)",
    },
    gotags = ["acceptance_bd_contract"],
    test = ":acceptance_test",
)

go_variant_test(
    name = "bd_cli_contract_current_test",
    size = "large",
    args = [BD_CLI_CONTRACT_RUN],
    data = ["@bd_bin_v1_3_1//:bd"],
    env = {
        "GC_ACCEPTANCE_BD_BIN": "$(rootpath @bd_bin_v1_3_1//:bd)",
        "GC_TEST_TOOL_PATHS": "$(rootpath @bd_bin_v1_3_1//:bd)",
    },
    gotags = ["acceptance_bd_contract"],
    test = ":acceptance_test",
)

[go_variant_test(
    name = name,
    size = "large",
    args = ["-test.run=^%s$$%s" % (
        test,
        SOLO_SUBTESTS.get(name, ""),
    )],
    data = SOLO_DATA.get(name, []),
    env = SOLO_ENV.get(name, {}),
    tags = ["manual"],
    test = ":acceptance_test",
) for name, test in SOLO_TESTS.items()]

test_suite(
    name = "acceptance_solo_tests",
    tags = ["manual"],
    tests = [":" + name for name in SOLO_TESTS],
)

[go_variant_test(
    name = name,
    size = "large",
    args = ["-test.run=^%s$$" % test],
    tags = ["manual"],
    test = ":acceptance_test",
) for name, test in REALTIME_TESTS.items()]

test_suite(
    name = "acceptance_realtime_tests",
    tags = ["manual"],
    tests = [":" + name for name in REALTIME_TESTS],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
