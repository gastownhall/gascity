load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "filebdshim_lib",
    srcs = ["main.go"],
    importpath = "github.com/gastownhall/gascity/test/integration/filebdshim",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/beads",
        "//internal/events",
        "//internal/fsys",
    ],
)

go_binary(
    name = "filebdshim",
    embed = [":filebdshim_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "filebdshim_test",
    srcs = [
        "main_test.go",
        "testenv_import_test.go",
    ],
    embed = [":filebdshim_lib"],
    deps = [
        "//internal/beads",
        "//internal/testenv",
    ],
)
