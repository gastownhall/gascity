load("@rules_go//go:def.bzl", "go_test")

# gazelle:build_tags integration

# bead_id_test.go and dolt_config_timeout_test.go carry no //go:build tag, so
# under the build_tags directive above gazelle would otherwise fold them into
# integration_test's srcs alongside every integration-tagged file. Excluding
# them here hands them to the unsharded go_test below instead, so
# integration_test's shard_count only spreads integration-tagged work.
# bead_id_helpers_test.go is deliberately NOT excluded: helpers_test.go
# (integration-tagged) calls parseBeadID, so that file stays reachable from
# both go_test targets below, same as testenv_import_test.go.
# gazelle:exclude bead_id_test.go
# gazelle:exclude dolt_config_timeout_test.go

# keep
go_test(
    name = "integration_unsharded_test",
    srcs = [
        "bead_id_helpers_test.go",
        "bead_id_test.go",
        "dolt_config_timeout_test.go",
        "testenv_import_test.go",
    ],
    # bead_id_test.go reads ../agents/lib/bead-id.sh and ../agents/*.sh;
    # dolt_config_timeout_test.go parses dolt_config_test.go as a text
    # fixture (it is not a source dep). //test:agents covers the former,
    # the glob covers the latter.
    data = glob(
        ["*.go"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//test:agents",
    ],
    tags = [
        "external",
        "requires-network",
    ],
    deps = [
        "//internal/testenv",
    ],
)

go_test(
    name = "integration_test",
    srcs = [
        "bdstore_batch_delete_test.go",
        "bdstore_runner_isolation_test.go",
        "bdstore_test.go",
        "bead_id_helpers_test.go",
        "dolt_config_test.go",
        "dolt_persistence_test.go",
        "e2e_comm_test.go",
        "e2e_config_test.go",
        "e2e_events_test.go",
        "e2e_helpers_test.go",
        "e2e_hook_test.go",
        "e2e_lifecycle_test.go",
        "e2e_mail_test.go",
        "e2e_multi_test.go",
        "e2e_pool_test.go",
        "e2e_test.go",
        "gastown_config_test.go",
        "gastown_controller_test.go",
        "gastown_events_test.go",
        "gastown_formula_test.go",
        "gastown_handoff_test.go",
        "gastown_helpers_test.go",
        "gastown_mail_test.go",
        "gastown_multirig_test.go",
        "gastown_pipeline_test.go",
        "gastown_polecat_test.go",
        "gastown_pool_test.go",
        "gastown_reconciler_test.go",
        "gastown_refinery_test.go",
        "gastown_shutdown_test.go",
        "gastown_sling_test.go",
        "gastown_witness_test.go",
        "gc_live_contract_store_conflict_test.go",
        "gc_live_contract_test.go",
        "graph_dispatch_harness_test.go",
        "graph_dispatch_test.go",
        "helpers_test.go",
        "huma_binary_test.go",
        "integration_test.go",
        "mail_test.go",
        "review_check_scripts_test.go",
        "review_formula_test.go",
        "session_k8s_test.go",
        "skill_lifecycle_test.go",
        "start_drift_test.go",
        "supervisor_unit_guard_test.go",
        "testenv_import_test.go",
        "tool_home_test.go",
        "tutorial_path_test.go",
        "workflow_event_wait_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [
        "//:go.mod",
        "//test:agents",
    ] + select({
        # Only the integration-tagged tests exec these. The untagged tests that
        # also build in the default configuration (bead_id_test.go,
        # dolt_config_timeout_test.go) read sources only, so `bazel test //...`
        # neither links nor stages them; the gc links are 207 MB each.
        "//:gotags_integration": [
            "//cmd/gc",
            "//cmd/gc:gc_drift_new",
            "//cmd/gc:gc_drift_old",
            "//examples/bd",
            "//test/integration/filebdshim",
            # Pinned prebuilt release binaries (see MODULE.bazel): hermetic bd
            # and dolt for the dolt-backed integration shapes, same versions the
            # go-test CI installs via install-bd-archive.sh /
            # install-dolt-archive.sh.
            "@bd_bin_v1_3_1//:bd",
            "@dolt_bin_v2_2_0//:dolt-linux-amd64/bin/dolt",
        ],
        "//conditions:default": [],
    }),
    shard_count = 14,
    tags = [
        "external",
        "requires-network",
    ],
    deps = [
        "//internal/bazeltest",
        "//internal/beads",
        "//internal/beads/beadstest",
        "//internal/beads/contract",
        "//internal/builtinpacks",
        "//internal/citylayout",
        "//internal/config",
        "//internal/doctor",
        "//internal/events",
        "//internal/fsys",
        "//internal/materialize",
        "//internal/pathutil",
        "//internal/runtime",
        "//internal/runtime/exec",
        "//internal/runtime/runtimetest",
        "//internal/supervisor",
        "//internal/testenv",
        "//internal/testfixtures/reviewworkflows",
        "//internal/testutil",
        "//test/acceptance/helpers",
        "//test/dolttest",
        "//test/tmuxtest",
        "//test/toolhome",
        "@com_github_cenkalti_backoff_v4//:backoff",
        "@com_github_gastownhall_gascity_packs//:gascity-packs",
        "@com_github_pb33f_libopenapi//:libopenapi",
        "@com_github_pb33f_libopenapi_validator//:libopenapi-validator",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# The shard placement guard (scripts/integration_shards_test.go) reads this
# file's srcs and shard_count.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//scripts:__pkg__"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
