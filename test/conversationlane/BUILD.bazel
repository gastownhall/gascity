load("@rules_go//go:def.bzl", "go_test")
load("//tools/bazel/rules:go_variant_test.bzl", "go_variant_test")

# The op-journal evidence against real gc processes: X2's kill matrix, X6's
# fan-in and X8's order across a lane-host restart (OJ-12x), and X12's O0
# crash matrix, fault-free load and incapable-store arm (OJ-8). Only the
# integration build stages the test-hooks gc (the one link that honors
# GC_LANE_FAILPOINT and GC_OPS_FAILPOINT) and the fake exec runtime, so
# `bazel test //...` neither links nor stages them;
# scripts/cmd_gc_testhooks_test.go pins GC_LANE_GC_BIN. Unsharded: one action
# in //test:integration_packages, whose action count is pinned
# (scripts/bazel_integration_packages_budget_test.go). X6 measures latency
# alone, before the others run their cities in parallel (harness_test.go's
# cityParallel); X12 runs its gating subset here, its small load in parallel
# with the rest (it reports latency without asserting it). Only the evidence
# load runs alone.
go_test(
    name = "conversationlane_test",
    size = "large",
    srcs = [
        "harness_test.go",
        "inline_pass_test.go",
        "main_test.go",
        "testenv_import_test.go",
        "x12_evidence_guard_test.go",
        "x12_harness_test.go",
        "x12_incapable_test.go",
        "x12_load_test.go",
        "x12_matrix_test.go",
        "x12_report_test.go",
        "x2_test.go",
        "x6_test.go",
        "x8_test.go",
    ],
    data = select({
        "//:gotags_integration": [
            "//cmd/gc:gc_testhooks",
            "//test/conversationlane/fakeruntime",
        ],
        "//conditions:default": [],
    }),
    env = select({
        "//:gotags_integration": {
            "GC_LANE_FAKE_RUNTIME": "$(rootpath //test/conversationlane/fakeruntime)",
            "GC_LANE_GC_BIN": "$(rootpath //cmd/gc:gc_testhooks)",
        },
        "//conditions:default": {},
    }),
    deps = [
        "//internal/api/genclient",
        "//internal/bazeltest",
        "//internal/beads",
        "//internal/clock",
        "//internal/loopbackport",
        "//internal/opjournal",
        "//internal/pathutil",
        "//internal/storebinding/sqlite",
        "//internal/testenv",
    ],
)

# X12's evidence (DES-O0API §15 OJ-8, G-X12), per backend in two parts: the
# matrix part runs every kill-matrix cell at production timing and waits out
# each op's finish_by (P1-P3, P5) and, on Dolt, the incapable-store arm; the
# load part runs the fault-free load, six rounds on SQLite and three on
# embedded Dolt (P4, R1-R3). Each writes
# x12-report-<backend>-<part>.{json,md} to its undeclared outputs. Manual,
# outside the integration lane's suite, and local (tagged so: a part runs
# from 30 minutes on SQLite to well over an hour on embedded Dolt, past the
# remote executor's 1200 s action cap). Every variant also selects
# TestX12EvidenceNeedsTheIntegrationBuild, which fails a run built without
# --config=integration instead of letting it pass with no test. Run with
#
#   bazel test --config=ci --config=integration --strategy=TestRunner=local \
#     --test_timeout=7200 --test_env=GC_X12_SOURCE="$(git rev-parse HEAD)" \
#     //test/conversationlane:x12_evidence
#
# (GC_X12_SOURCE names the source revision in the report: the test-hooks gc
# is not stamped.)
# and add --local_test_jobs=1 for R2 latency measured with nothing beside it.
[go_variant_test(
    name = "x12_evidence_%s_%s_test" % (backend, part),
    size = "enormous",
    args = ["-test.run=" + run],
    env = {
        "GC_X12_BACKEND": backend,
        "GC_X12_EVIDENCE": "1",
        "GC_X12_PART": part,
    },
    tags = [
        "local",
        "manual",
        "no-remote",
    ],
    test = ":conversationlane_test",
) for backend in [
    "sqlite",
    "dolt",
] for part, run in [
    ("matrix", "^TestX12(KillMatrix|IncapableStore|EvidenceNeedsTheIntegrationBuild)$$"),
    ("load", "^TestX12(FaultFreeLoad|EvidenceNeedsTheIntegrationBuild)$$"),
]]

test_suite(
    name = "x12_evidence",
    tags = ["manual"],
    tests = [
        ":x12_evidence_dolt_load_test",
        ":x12_evidence_dolt_matrix_test",
        ":x12_evidence_sqlite_load_test",
        ":x12_evidence_sqlite_matrix_test",
    ],
)

# scripts/cmd_gc_testhooks_test.go reads this file.
exports_files(
    ["BUILD.bazel"],
    visibility = ["//scripts:__pkg__"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
