load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "fakeclaude_lib",
    srcs = [
        "main.go",
        "native_transcript.go",
    ],
    importpath = "github.com/gastownhall/gascity/test/conversationlane/fakeclaude",
    visibility = ["//visibility:private"],
    deps = ["@org_golang_x_term//:term"],
)

go_binary(
    name = "fakeclaude",
    embed = [":fakeclaude_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "fakeclaude_test",
    srcs = [
        "native_transcript_test.go",
        "testenv_import_test.go",
    ],
    embed = [":fakeclaude_lib"],
    deps = [
        "//internal/sessionlog",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
