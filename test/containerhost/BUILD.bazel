load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "containerhost",
    srcs = [
        "docker.go",
        "host.go",
        "tools.go",
    ],
    importpath = "github.com/gastownhall/gascity/test/containerhost",
    visibility = ["//visibility:public"],
)

go_test(
    name = "containerhost_test",
    srcs = [
        "docker_session_test.go",
        "docker_test.go",
        "main_test.go",
        "testenv_import_test.go",
    ],
    # The Docker session adapter under test runs against this package's
    # emulated container host; its tmux, bash and jq are the worker image's
    # (tools/rbe/worker-env.txt).
    data = ["//scripts:gc-session-docker"],
    embed = [":containerhost"],
    env = {"GC_SESSION_DOCKER_SCRIPT": "$(rootpath //scripts:gc-session-docker)"},
    deps = [
        "//internal/bazeltest",
        "//internal/testenv",
        "//test/tmuxtest",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
