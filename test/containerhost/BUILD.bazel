go_test(
    name = "containerhost_test",
    srcs = [
        "docker_session_test.go",
        "docker_test.go",
        "k8s_session_test.go",
        "kubectl_test.go",
        "main_test.go",
        "testenv_import_test.go",
    ],
    # The Docker and K8s session adapters under test run against this
    # package's emulated container host; their tmux, bash and jq are the
    # worker image's (tools/rbe/worker-env.txt).
    data = [
        "//contrib:session-scripts/gc-session-k8s",
        "//scripts:gc-session-docker",
    ],
    embed = [":containerhost"],
    env = {
        "GC_SESSION_DOCKER_SCRIPT": "$(rootpath //scripts:gc-session-docker)",
        "GC_SESSION_K8S_SCRIPT": "$(rootpath //contrib:session-scripts/gc-session-k8s)",
    },
    deps = [
        "//internal/testenv",
    ] + select({
        "@rules_go//go/platform:aix": [
            "//internal/bazeltest",
            "//internal/runtime",
            "//internal/runtime/exec",
            "//internal/runtime/runtimetest",
            "//test/tmuxtest",
        ],
        "@rules_go//go/platform:android": [
            "//internal/bazeltest",
