load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dolttest",
    srcs = [
        "dolttest.go",
        "dolttest_unix.go",
        "dolttest_windows.go",
    ],
    importpath = "github.com/gastownhall/gascity/test/dolttest",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/doltorphan",
    ] + select({
        "@rules_go//go/platform:windows": [
            "//internal/pidutil",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "dolttest_test",
    srcs = [
        "dolttest_test.go",
        "testenv_import_test.go",
    ],
    embed = [":dolttest"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
